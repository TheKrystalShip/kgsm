<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    TheKrystalShip.* packages resolve from the org's GitHub Packages feed, merged with nuget.org so
    Microsoft.* still resolves. No credentials live here: GitHub Packages requires a token even for a
    package marked public, so the token is supplied per-machine — ~/.nuget/NuGet/NuGet.Config on a
    workstation, and the automatic GITHUB_TOKEN with `permissions: packages: read` in CI. The source
    key must stay "github" so a stored credential matches it by name.

    A node never reads this feed. Nodes install pacman packages carrying compiled binaries; only a
    machine that BUILDS needs a token.
  -->
  <packageSources>
    <!-- Exclusive: a source configured on the machine cannot leak into a build here, so what
         restores locally is what restores in CI. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/TheKrystalShip/index.json" />
  </packageSources>
</configuration>
