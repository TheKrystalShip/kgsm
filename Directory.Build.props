<Project>

  <!--
    The engine's C# projects (src/ and tests/) share one version and one set of language defaults.
    The bash tree beside them has no project files and is not affected.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>4.0.0-dev.4</Version>
    <Authors>TheKrystalShip</Authors>
    <RepositoryUrl>https://github.com/TheKrystalShip/kgsm</RepositoryUrl>
  </PropertyGroup>

</Project>
