{
  "name": "kgsm-extension",
  "displayName": "KGSM",
  "description": "Manage KGSM game server blueprints and instances from the VS Code sidebar",
  "version": "0.1.0",
  "publisher": "TheKrystalShip",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kgsm-explorer",
          "title": "KGSM",
          "icon": "$(notebook-kernel-select)"
        }
      ]
    },
    "views": {
      "kgsm-explorer": [
        {
          "id": "kgsm-blueprints",
          "name": "Blueprints",
          "icon": "$(folder-library)",
          "type": "tree"
        },
        {
          "id": "kgsm-instances",
          "name": "Instances",
          "icon": "$(game)",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "kgsm.openBlueprint",
        "title": "KGSM: Open Blueprint",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kgsm.refreshBlueprints",
        "title": "KGSM: Refresh Blueprints",
        "icon": "$(refresh)"
      },
      {
        "command": "kgsm.refreshInstances",
        "title": "KGSM: Refresh Instances",
        "icon": "$(refresh)"
      },
      {
        "command": "kgsm.startInstance",
        "title": "KGSM: Start Instance",
        "icon": "$(debug-start)"
      },
      {
        "command": "kgsm.stopInstance",
        "title": "KGSM: Stop Instance",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kgsm.restartInstance",
        "title": "KGSM: Restart Instance",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kgsm.updateInstance",
        "title": "KGSM: Update Instance",
        "icon": "$(cloud-download)"
      },
      {
        "command": "kgsm.openInstanceLog",
        "title": "KGSM: Open Instance Log",
        "icon": "$(output)"
      },
      {
        "command": "kgsm.openInstanceConfig",
        "title": "KGSM: Open Instance Config",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kgsm.openManagementScript",
        "title": "KGSM: Open Management Script",
        "icon": "$(file-code)"
      },
      {
        "command": "kgsm.addBlueprint",
        "title": "KGSM: Add New Blueprint",
        "icon": "$(add)"
      },
      {
        "command": "kgsm.createInstance",
        "title": "KGSM: Create New Instance",
        "icon": "$(add)"
      },
      {
        "command": "kgsm.openSettings",
        "title": "KGSM: Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kgsm.refreshBlueprints",
          "when": "view == kgsm-blueprints",
          "group": "navigation@1"
        },
        {
          "command": "kgsm.openSettings",
          "when": "view == kgsm-blueprints",
          "group": "navigation@2"
        },
        {
          "command": "kgsm.refreshInstances",
          "when": "view == kgsm-instances",
          "group": "navigation@1"
        },
        {
          "command": "kgsm.createInstance",
          "when": "view == kgsm-instances",
          "group": "navigation@2"
        },
        {
          "command": "kgsm.openSettings",
          "when": "view == kgsm-instances",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "kgsm.addBlueprint",
          "when": "view == kgsm-blueprints && viewItem =~ /^blueprintCategory/",
          "group": "inline"
        },
        {
          "command": "kgsm.openBlueprint",
          "when": "view == kgsm-blueprints && viewItem == blueprint",
          "group": "inline"
        },
        {
          "command": "kgsm.startInstance",
          "when": "view == kgsm-instances && viewItem =~ /^instance/ && viewItem =~ /stopped/",
          "group": "inline@1"
        },
        {
          "command": "kgsm.stopInstance",
          "when": "view == kgsm-instances && viewItem =~ /^instance/ && viewItem =~ /running/",
          "group": "inline@1"
        },
        {
          "command": "kgsm.restartInstance",
          "when": "view == kgsm-instances && viewItem =~ /^instance/ && viewItem =~ /running/",
          "group": "inline@2"
        },
        {
          "command": "kgsm.updateInstance",
          "when": "view == kgsm-instances && viewItem =~ /^instance/",
          "group": "6_update"
        },
        {
          "command": "kgsm.openInstanceLog",
          "when": "view == kgsm-instances && viewItem =~ /^instance/",
          "group": "3_open@1"
        },
        {
          "command": "kgsm.openInstanceConfig",
          "when": "view == kgsm-instances && viewItem =~ /^instance/",
          "group": "3_open@2"
        },
        {
          "command": "kgsm.openManagementScript",
          "when": "view == kgsm-instances && viewItem =~ /^instance/",
          "group": "3_open@3"
        }
      ]
    },
    "configuration": {
      "title": "KGSM",
      "properties": {
        "kgsm.scriptPath": {
          "type": "string",
          "default": "/usr/local/bin/kgsm",
          "description": "Absolute path to the kgsm script (e.g. /usr/local/bin/kgsm or /opt/kgsm/kgsm.sh)",
          "order": 0
        },
        "kgsm.pollInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Instance status refresh interval in seconds",
          "order": 1
        }
      }
    }
  },
  "scripts": {},
  "devDependencies": {}
}
