# KGSM Blueprint Template (unified YAML format)
#
# Krystal Game Server Manager (KGSM) Blueprint Template
# This template defines the configuration for a game server managed by KGSM.
#
# Author: Cristian Moraru <cristian.moraru@live.com>
# Version: 3.0
#
# Copyright (c) 2025 The Krystal Ship
# Licensed under the GNU General Public License v3.0
# https://www.gnu.org/licenses/gpl-3.0.en.html
#
# =============================================================================
# ABOUT KGSM BLUEPRINTS
# =============================================================================
#
# A blueprint is a single YAML file that is the COMPLETE identity of a game
# server: presentation metadata plus everything needed to install, configure,
# and run it. One file per game, named "<name>.bp.yaml", in a single flat
# blueprints/ directory. The `runtime` field — native or container — decides
# how the server runs; there is no native/ vs container/ split anymore.
#
# Blueprints can be:
# - Default blueprints (included with KGSM, under the system blueprints dir)
# - Custom blueprints (yours, under ~/.local/share/kgsm/blueprints/), which
#   shadow a same-named default blueprint.
#
# =============================================================================
# CREATING A NEW BLUEPRINT
# =============================================================================
#
# 1. Copy this file to your user blueprints dir as <your_game>.bp.yaml
# 2. Set `runtime` and fill the matching block (native: OR container:)
# 3. Fill the metadata you know; leave anything unknown as null (NEVER 0).
# 4. Test:  ./kgsm.sh blueprints info <your_game>
#           ./kgsm.sh create <your_game> --install-dir /path/to/install
#
# Required fields:
#   - schema_version (currently 1)
#   - name           (unique, lowercase, no spaces — also the override key)
#   - runtime        (native | container)
#   - native:        executable_file        (when runtime: native)
#   - container:     compose                (when runtime: container)
#
# DO NOT MODIFY THIS TEMPLATE FILE. Copy it instead.

# Blueprint schema version (do not change unless migrating formats).
schema_version: 1

# Unique name, lowercase, no spaces. Also the override-binding key: a blueprint
# named "terraria" uses overrides/terraria/ regardless of the file name.
name: example

# How the server runs: native (a Linux process supervised by kgsm-watchdog) or
# container (a Docker Compose stack). Pick one and fill the matching block.
runtime: native

# -----------------------------------------------------------------------------
# Presentation metadata (advisory — for catalogs / the control panel)
# -----------------------------------------------------------------------------
# All values are nullable. `null` means "unknown / unbounded" — it is NEVER a
# substitute for a real 0. The resource numbers are vendor-declared estimates,
# not measured guarantees, and storage in particular grows after install.
metadata:
  display_name: null        # e.g. "7 Days to Die"
  description: null          # one-line blurb
  rawg_slug: null            # RAWG.io game slug for cover art/metadata lookup
                             # (e.g. "garrys-mod"); null if not on RAWG / unverified
  max_players: null          # integer, or null if unbounded/configurable
  min_ram_mb: null           # advisory minimum RAM (MB)
  recommended_ram_mb: null   # advisory recommended RAM (MB)
  base_disk_mb: null         # install footprint (MB); grows with saves/mods

# -----------------------------------------------------------------------------
# Player-presence detection (optional, top-level — applies to both runtimes)
# -----------------------------------------------------------------------------
# Regexes matched against the game server's log output to detect a player
# joining/leaving. For OUR container images the in-image shim does the matching
# and self-reports; KGSM forwards these patterns to the container as the env
# vars KGSM_PLAYER_JOINED_REGEX_B64 / KGSM_PLAYER_LEFT_REGEX_B64 (base64-encoded
# — see the container vars below). For a NATIVE instance the kgsm-watchdog reads
# these (materialized into the instance config) and matches the instance's log
# itself. Leave EMPTY/unset to disable that detection (honest unknown — no event
# is invented). Author these from REAL server output, never guessed. Optional
# named groups (?<id>...) / (?<name>...) populate the event's player_id /
# player_name; at least one must match.
# NOTE: the field is consumed by TWO regex engines depending on runtime — Perl
# in the container shim, .NET System.Text.RegularExpressions in the watchdog —
# so author a pattern valid in the engine of the runtime this game uses.
# player_joined_regex: ''
# player_left_regex: ''

# -----------------------------------------------------------------------------
# RCON polling (optional, top-level) — the other source of player presence
# -----------------------------------------------------------------------------
# For a game whose console does not announce joins and leaves in its log, or
# announces only one of the two. Instead of reading events as they scroll past,
# the roster is asked for outright on an interval and the answer diffed against
# the previous one, so a join is the appearance of a player and a leave is a
# disappearance.
#
# Declare these fields even when the game does not use RCON: an empty rcon_port
# leaves polling off, and their presence is how a reader sees the capability is
# available and simply not wired up for this game yet.
#
# rcon_players_regex is matched PER LINE against what rcon_players_command
# answers, with optional named groups (?<id>...) / (?<name>...); an entry carries
# whichever the server actually states, and one that captures neither is not a
# player. Games word their rosters differently — a header and one `-Name` line
# per player here, an id and a name in columns there — so carrying the shape in
# the blueprint is what lets one poller read any game without knowing which it is
# talking to. Empty means the answer cannot be read, which is NOT the same as a
# server reporting nobody connected: the poller skips the instance rather than
# report an absence it did not measure.
#
# Author every value from a server observed answering it, never guessed. Presence
# polling applies to NATIVE instances; a container blueprint may declare these,
# but nothing reads them yet.
# rcon_port: ""
# rcon_password: ""
# rcon_poll_interval_seconds: 10
# rcon_players_command: ""
# rcon_players_regex: ''

# -----------------------------------------------------------------------------
# Player moderation (optional, top-level — applies to both runtimes)
# -----------------------------------------------------------------------------
# The console commands this game accepts to remove a player, block them, and
# lift that block. KGSM sends them down the same channel as save_command /
# `input`, so author them from REAL server commands, never guessed.
#
# Each value is a TEMPLATE carrying EXACTLY ONE placeholder, and the placeholder
# NAMES the identity token the game expects:
#   {ip}    an IP address        e.g. 'kick {ip}'
#   {name}  a player/character name  e.g. 'ban {name}'
#   {id}    an account/user id    e.g. 'banid {id}'
# That name is the contract every caller reads to know what to pass, so a
# roster button sends the right token instead of guessing — which is why the
# kind lives in the template and nowhere else, where the two could disagree.
# Anything outside the placeholder is sent verbatim.
#
# Leave EMPTY/unset when the game has no such command. That is an honest
# unknown: KGSM refuses the action rather than approximating it with a
# different one (a kick standing in for a ban is a fabricated outcome).
# kick_command: ''
# ban_command: ''
# unban_command: ''

# -----------------------------------------------------------------------------
# NATIVE runtime (delete this block for container blueprints)
# -----------------------------------------------------------------------------
native:
  # Port(s) in UFW format, single string, pipe-separated.
  # Example: '1111:2222/tcp|3333/udp'
  ports: ''

  # Steam App ID of the DEDICATED SERVER (0 if not a Steam download).
  steam_app_id: 0

  # Client Steam App ID — the game players launch to connect (0 if not Steam).
  client_steam_app_id: 0

  # Extra steamcmd arguments, e.g. "+beta <branch>". Empty if none.
  steamcmd_arguments: ""

  # Only relevant when steam_app_id != 0: true if a Steam account is required.
  is_steam_account_required: false

  # Target platform: linux | windows | macos (linux unless using compatibility).
  platform: linux

  # Default world/save/level name.
  level_name: default

  # Optional subdirectory (relative to the install dir) the binary runs from,
  # e.g. /bin/x86_64. Empty if the binary sits at the install root.
  executable_subdirectory: ""

  # The executable that starts the server (required).
  executable_file: start_server.sh

  # Arguments passed to the executable. $instance_* variables are resolved at
  # instance-creation time (see docs/blueprints.md for the full list). Use
  # single quotes so the literal '$' is preserved.
  executable_arguments: ''

  # Optional command sent to the input socket to gracefully stop the server.
  stop_command: ""

  # Optional command sent to the input socket to save the game state.
  save_command: ""

  # Optional regex matched against server output to detect successful startup.
  # If empty, KGSM waits for the server to listen on its ports.
  startup_success_regex: ""

# -----------------------------------------------------------------------------
# CONTAINER runtime (use INSTEAD of the native block; set runtime: container)
# -----------------------------------------------------------------------------
# Embed the Docker Compose definition VERBATIM as a literal block scalar (the
# "|" below). KGSM extracts it to the instance's docker-compose.yml and expands
# any ${instance_*} placeholders.
#
# Every service MUST set `network_mode: host` (KGSM validates this and rejects a
# blueprint without it). KGSM containers share the host network stack, so the
# game process listens directly on the host exactly like a native instance and
# the host firewall (ufw / kgsm-firewall) governs it through the INPUT chain. A
# bridge-networked service would instead DNAT-publish its `ports:`, bypassing
# that firewall — not allowed.
#
# Under host networking Docker IGNORES the `ports:` block; KGSM does not. `ports:`
# is the declarative source of truth KGSM derives the host-firewall rule and the
# router UPnP mappings (kgsm-watchdog) from, and documents which ports the server
# uses. Keep it accurate; do not add a separate top-level ports field.
#
# Player-presence vars available to the compose body (see the top-level
# player_*_regex fields): bind-mount the DIRECTORY ${instance_events_dir} to
# /run/kgsm so the in-image shim can write its NDJSON channel
# (/run/kgsm/events.ndjson) and replace it with a fresh inode each start, and
# pass ${instance_player_joined_regex_b64} / ${instance_player_left_regex_b64}
# (KGSM base64-encodes the regexes — raw patterns mangle through compose/shell)
# as the KGSM_PLAYER_JOINED_REGEX_B64 / KGSM_PLAYER_LEFT_REGEX_B64 env vars.
#
# container:
#   compose: |
#     services:
#       example:
#         image: ghcr.io/thekrystalship/example:latest
#         container_name: ${instance_name}
#         network_mode: host
#         ports:
#           - 1234:1234/udp
#         volumes:
#           - type: bind
#             source: ${instance_install_dir}
#             target: /opt/example/install
#           # Player-presence event channel (the watchdog tails events.ndjson
#           # inside this directory):
#           - type: bind
#             source: ${instance_events_dir}
#             target: /run/kgsm
#         environment:
#           KGSM_PLAYER_JOINED_REGEX_B64: ${instance_player_joined_regex_b64}
#           KGSM_PLAYER_LEFT_REGEX_B64: ${instance_player_left_regex_b64}
#         restart: unless-stopped
