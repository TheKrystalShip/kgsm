#!/usr/bin/env bash

################################################################################
#                       KGSM OVERRIDE MODULES REFERENCE                        #
################################################################################
# This file documents how to create game-specific override modules for KGSM.
#
# KGSM uses a module-based override system. Rather than a single monolithic
# override script, each override is a directory of numbered module files that
# correspond to (and replace) default modules during management script assembly.
#
################################################################################
#
# DIRECTORY STRUCTURE:
#
#   overrides/
#   └── {blueprint_name}/          ← one directory per game
#       ├── 05-version.sh          ← replaces templates/manage.native.d/05-version.sh
#       ├── 06-download.sh         ← replaces templates/manage.native.d/06-download.sh
#       └── 07-deploy.sh           ← replaces templates/manage.native.d/07-deploy.sh
#
# The {blueprint_name} is the value of the `name=` field in the blueprint file,
# NOT the blueprint filename. A blueprint named `terraria-modded.bp` with
# `name=terraria` uses `overrides/terraria/`.
#
################################################################################
#
# WHICH MODULES CAN BE OVERRIDDEN:
#
#   03-lifecycle.sh    Server start/stop/restart logic
#   04-io.sh           Input/output helpers (send_input, send_save_command)
#   05-version.sh      Version retrieval and comparison
#   06-download.sh     File download from remote sources
#   07-deploy.sh       File deployment from temp dir to install dir
#   08-backup.sh       Backup creation, listing, and restoration
#   10-logging.sh      Log printing and rotation
#   11-status.sh       Server status reporting
#
# Modules 00-02 (header, config, help) and 12-13 (commands, dispatch) are
# structural and cannot be overridden.
#
################################################################################
#
# HOW TO CREATE AN OVERRIDE MODULE:
#
# 1. Create the override directory for your game:
#      mkdir -p overrides/{blueprint_name}/
#    or for user overrides (preferred, survives updates):
#      mkdir -p ~/.local/share/kgsm/overrides/{blueprint_name}/
#
# 2. Copy the default module you want to override:
#      cp templates/manage.native.d/05-version.sh \
#         overrides/{blueprint_name}/05-version.sh
#    (Use manage.container.d/ for container-based servers.)
#
# 3. Modify only the functions you need to change. Keep all other functions
#    from the default module exactly as they are.
#
# 4. Test your override by creating a new instance from the blueprint.
#
################################################################################
#
# IMPORTANT GUIDELINES:
# - Override modules are COPIES of the default module with targeted changes.
# - ALL functions from the default module must be present in the override module.
# - Only modify the specific functions that require game-specific logic.
# - Helper functions private to the module should use the `__override_` prefix.
# - Ensure proper error handling and return codes in your implementations.
# - Use the provided logging functions for consistent output format.
# - Test overrides thoroughly before deploying to production.
# - Prefer user overrides (~/.local/share/kgsm/overrides/) over system overrides
#   so they are not overwritten by KGSM updates.
#
################################################################################
#
# OVERRIDE SEARCH PRIORITY (first match wins):
#
#   1. User overrides:   ${XDG_DATA_HOME:-~/.local/share}/kgsm/overrides/{name}/
#   2. System overrides: ${KGSM_ROOT}/overrides/{name}/
#   3. Default modules:  ${KGSM_ROOT}/templates/manage.{runtime}.d/
#
################################################################################
#
# EXAMPLE — Factorio version override (overrides/factorio/05-version.sh):
#
#   (copied from templates/manage.native.d/05-version.sh, then
#    _get_latest_version replaced with Factorio API call)
#
#   function _get_latest_version() {
#     local timeout="${instance_wget_timeout_seconds:-60}"
#     wget --timeout="$timeout" -qO - \
#       'https://factorio.com/api/latest-releases' |
#       jq .stable.headless |
#       tr -d '"'
#   }
#
#   # All other functions (_get_installed_version, _compare_versions,
#   # _save_version) are kept verbatim from the default module.
#
################################################################################
################################################################################
#
# AVAILABLE GLOBAL VARIABLES:
#
# Basic Instance Information:
# $instance_name                 Name of the instance
# $instance_blueprint_file       Path to the blueprint file
# $instance_install_datetime     When the instance was installed
#
# Directory and File Paths:
# $instance_working_dir          Working directory for the instance
# $instance_backups_dir          Directory for backups
# $instance_install_dir          Directory where the server is installed
# $instance_saves_dir            Directory for save files
# $instance_temp_dir             Temporary directory for downloads/processing
# $instance_logs_dir             Directory for logs
# $instance_launch_dir           Directory from which to launch server (may differ from install dir)
# $instance_executable_subdirectory  Subdirectory containing the executable
# $instance_management_file      Path to the management script
# $instance_compose_file         Path to docker-compose file (container only)
#
# Process Management Files:
# $instance_version_file         Path to the version file
# $instance_pid_file             Path to the PID file to track server process
# $instance_tail_pid_file        Path to the tail PID file
# $instance_socket_file          Path to the socket file for communication
#
# Runtime Configuration:
# $instance_runtime              Runtime type (native, container)
# $instance_platform             Platform type for SteamCMD (default: linux)
# $instance_auto_update          Whether to auto-update before starting
# $instance_logs_redirect        Log redirection pattern
#
# Game Server Configuration:
# $instance_level_name           Name of the level/world
# $instance_executable_file      Path to server executable
# $instance_executable_arguments Arguments to pass to executable
#
# Steam Integration:
# $instance_steam_app_id         Steam AppID (for Steam-based games)
# $instance_client_steam_app_id  Client Steam AppID (for launch/connect deeplinks)
# $instance_is_steam_account_required  Whether Steam account is needed (true/false)
#
# Network Configuration:
# $instance_ports                Network ports in UFW format
# $instance_enable_firewall_management  Whether firewall management is enabled (true/false)
# $instance_firewall_rule_file   Path to firewall rule file
#
# Server Control:
# $instance_stop_command         Command to gracefully stop server
# $instance_save_command         Command to save game state
# $instance_save_command_timeout_seconds  Seconds to wait for save command
# $instance_stop_command_timeout_seconds  Seconds to wait for graceful shutdown
#
# Backup Configuration:
# $instance_compress_backups     Whether to compress backups (true/false)
#
# System Integration:
#
# Management Features:
# $instance_enable_command_shortcuts  Whether command shortcuts are enabled (true/false)
# $instance_command_shortcut_file     Path to command shortcut file
#
# Global Configuration Variables:
# $config_wget_timeout_seconds   Timeout for wget operations (default: 60)
# $config_webhook_timeout_seconds  Timeout for webhook requests (default: 10)
# $config_save_command_timeout_seconds  Timeout for save commands (default: 5)
# $config_stop_command_timeout_seconds  Timeout for stop commands (default: 30)
# $config_enable_logging         Whether logging is enabled (true/false)
# $config_enable_firewall_management  Whether firewall management is enabled (true/false)
# $config_enable_backup_compression  Whether backup compression is enabled (true/false)
#
################################################################################
################################################################################
