# KGSM Instance Configuration File
# Created: ${instance_install_datetime}
# This file contains configuration for a game server instance
# Do not edit this file manually unless you know what you're doing

#=============================================================================
# BASIC INSTANCE INFORMATION
# Core identification and metadata for this game server instance
#=============================================================================

# Name of the instance, used for identification and file naming
name="${instance_name}"

# Human-readable label for this instance. Free text — spaces, casing, emoji and
# punctuation are all fine, because nothing derives a path, a file name or a key
# from it. Not unique, and changed at any time with
# 'kgsm instances rename <instance> <text>'. Absent or empty reads as the
# instance's name above. One line: control characters and the surrounding
# whitespace are dropped when it is written, since this file is read line by
# line and a value cannot hold a line ending or a field separator.
display_name="${instance_display_name}"

# Path to the blueprint file used to create this instance
blueprint_file="${instance_blueprint_file}"

# Timestamp when the instance was installed
install_datetime="${instance_install_datetime}"

#=============================================================================
# DIRECTORY AND FILE PATHS
# All file system paths used by this instance
#=============================================================================

# Root of the library this instance is placed in. The working directory below
# sits at <library_dir>/instances/<blueprint>/<name>. Recorded as a path rather
# than a library name: every other path here is absolute, the registry is the
# only place names live, and renaming a library then costs nothing.
library_dir="${instance_library_dir}"

# Directory where the instance files are stored
working_dir="${instance_working_dir}"

# Directory where the instance backups are stored
backups_dir="${instance_backups_dir}"

# Directory where the instance install files are stored
install_dir="${instance_install_dir}"

# Directory where the instance saves are stored
saves_dir="${instance_saves_dir}"

# Directory where the instance temp files are stored
temp_dir="${instance_temp_dir}"

# Directory where the instance logs are stored
logs_dir="${instance_logs_dir}"

# (Container only) Directory bind-mounted to /run/kgsm in the container; the
# in-container player-presence shim writes events.ndjson inside it and the
# kgsm-watchdog tails that file.
events_dir="${instance_events_dir}"

# (Native only) Directory from which to launch the instance binary
launch_dir="${instance_launch_dir}"

# (Native only) If there's a specific subdirectory for the executable
executable_subdirectory="${instance_install_subdir}"

# (Native only) Path to the game server executable
executable_file="${instance_executable_file}"

# Path to the management script for this instance
management_file="${instance_manage_file}"

# (Container only) Path to the docker-compose file for this instance
compose_file="${instance_compose_file}"

#=============================================================================
# PROCESS MANAGEMENT FILES
# Files used for tracking and controlling running processes
#=============================================================================

# File that stores the current version of the game server
version_file="${instance_version_file}"

# File that stores the last upstream version an update check found, and when it
# was fetched. Written only by 'check-update --emit', so it is also the record of
# what has already been announced — a version already in here does not announce
# twice.
latest_version_file="${instance_latest_version_file}"

# File that stores the PID of the running server process
pid_file="${instance_pid_file}"

# Named pipe used for sending commands to the server
socket_file="${instance_socket_file}"

# File that stores the log of the running server process
log_file="${instance_log_file}"

#=============================================================================
# RUNTIME CONFIGURATION
# How the instance runs and is managed by the system
#=============================================================================

# Specifies that this is a containerized or native (non-containerized) game server
runtime="${instance_runtime}"

# Target platform for the game server (usually linux)
platform="${instance_platform}"

# Whether to automatically update the server before starting (true | false)
auto_update="${instance_auto_update_before_start:-false}"

# CPU scheduling priority for this instance's cgroup (low | normal | high).
# Translated to cgroup cpu.weight by the watchdog: low=50, normal=100, high=400.
# Empty / "normal" = default weight.
cpu_priority="${instance_cpu_priority:-normal}"

# Maximum memory for this instance's cgroup in MiB (0 = uncapped).
# Applied by the watchdog at spawn via cgroup memory.max.
memory_cap_mb="${instance_memory_cap_mb:-0}"

# Scheduled restart cadence (off | daily | weekly | 6h). Enforced by the
# kgsm-scheduler leaf; inert on hosts without the scheduler deployed.
scheduled_restart="${instance_scheduled_restart:-off}"

# Time of day to perform the scheduled restart (HH:MM, 24h, host-local timezone).
restart_time="${instance_restart_time:-04:00}"

# Day of week for weekly restarts (sun | mon | tue | wed | thu | fri | sat).
# Only used when scheduled_restart=weekly.
restart_day="${instance_restart_day:-sun}"

# IANA timezone for scheduling (e.g. Europe/Madrid). Empty = host-local. Shared
# by the restart and backup schedules — one instance, one answer for what time
# it is.
timezone="${instance_timezone:-}"

# Scheduled backup cadence (off | daily | weekly | 6h). Enforced by the
# kgsm-scheduler leaf; inert on hosts without the scheduler deployed. Backups run
# against the instance as it is, running or not, so this cadence is independent
# of scheduled_restart — the two schedules share only the timezone below.
backup_schedule="${instance_backup_schedule:-off}"

# Time of day to take the scheduled backup (HH:MM, 24h). Interpreted in the
# instance's timezone. Ignored when backup_schedule=6h.
backup_time="${instance_backup_time:-05:00}"

# Day of week for weekly backups (sun | mon | tue | wed | thu | fri | sat).
# Only used when backup_schedule=weekly.
backup_day="${instance_backup_day:-sun}"

# Number of backups to keep after each scheduled backup prunes (1-100).
# 0 = keep all (no pruning).
backup_retention="${instance_backup_retention:-5}"

# Announcement lead times before a scheduled restart, in minutes, comma-separated
# and largest-first by convention (e.g. "15,5,1"). Empty announces nothing, which
# is the default: a server speaking to its players is opt-in. Read by the
# kgsm-scheduler leaf; inert on hosts without it, and inert for a game whose
# blueprint declares no broadcast_command.
announce_lead_minutes="${instance_announce_lead_minutes}"

# What each lead-time announcement says. {minutes} is the lead being announced and
# {instance} is this instance's display name; anything else is sent verbatim.
announce_restart_message="${instance_announce_restart_message}"

# What is said when an announced restart is abandoned — the server stopped, or the
# watchdog gave up on it, between the first announcement and the restart itself.
# Players were told a restart was coming, so they are told it is not.
announce_restart_cancelled_message="${instance_announce_restart_cancelled_message}"

# Whether the kgsm-watchdog should auto-restart this instance on crash (true|false).
crash_restart="${instance_crash_restart:-true}"

# Max consecutive crash-restarts before the watchdog gives up (integer).
crash_max_restarts="${instance_crash_max_restarts:-5}"

# Regex pattern to match the startup success message in the log file
startup_success_regex="${instance_startup_success_regex}"

# Player-presence detection patterns (from the blueprint). For a NATIVE instance
# the kgsm-watchdog reads these (via `instances info --json`) and matches them
# against this instance's log to emit player join/left events. Empty = that
# detection is disabled (honest unknown). Containers use the base64 env form +
# in-image shim instead; the matching engine differs (.NET here, Perl in-shim).
player_joined_regex="${instance_player_joined_regex:-}"
player_left_regex="${instance_player_left_regex:-}"

# RCON connection parameters (from the blueprint). The kgsm-watchdog reads these
# via `instances info --json` to poll the game server for connected players when
# log-based leave detection is unavailable. Empty rcon_port = no RCON detection.
# The password is stored in plaintext; the user must also configure the game
# server's own RCON with matching values.
rcon_port="${instance_rcon_port:-}"
rcon_password="${instance_rcon_password:-}"
rcon_poll_interval_seconds="${instance_rcon_poll_interval_seconds:-10}"
# Empty when the blueprint names none. Defaulting this to some game's command
# would have every instance claim a way to list its players, including the ones
# whose server has no such command.
rcon_players_command="${instance_rcon_players_command:-}"
# How to read one player out of that command's output, applied per line, with
# optional named groups `id` and `name`. Games word their rosters differently,
# so the shape is data here rather than knowledge held by whatever polls it.
# Empty = the output cannot be read, so RCON presence is off for this instance.
rcon_players_regex="${instance_rcon_players_regex:-}"

#=============================================================================
# GAME SERVER EXECUTABLE CONFIGURATION
# Settings for running the actual game server binary
#=============================================================================

# Default level/world name for the game server
level_name="${instance_level_name:-default}"

# Command line arguments for the game server executable
executable_arguments="${instance_executable_arguments}"

#=============================================================================
# STEAM INTEGRATION
# Configuration for Steam/SteamCMD integration
#=============================================================================

# Steam App ID for SteamCMD downloads (0 if not applicable)
steam_app_id="${instance_steam_app_id:-0}"

# Client Steam App ID for launch/connect deeplinks (0 if not applicable)
client_steam_app_id="${instance_client_steam_app_id:-0}"

# Additional arguments to pass to SteamCMD (if applicable)
steamcmd_arguments="${instance_steamcmd_arguments:-}"

# Whether a Steam account is required for downloading (true | false)
is_steam_account_required="${instance_is_steam_account_required:-false}"

#=============================================================================
# NETWORK CONFIGURATION
# Port settings, network security, and connectivity configuration
#=============================================================================

# Network ports used by the game server in UFW format
ports="${instance_ports}"

# Whether to enable firewall management (true | false)
enable_firewall_management="${instance_enable_firewall_management:-false}"

# Whether to forward this instance's ports on the router via UPnP (true | false).
# The kgsm-watchdog reads this (via `instances info --json`) and, when true, opens
# the ports as UPnP mappings on the IGD on bring-up and closes them on a stop —
# best-effort, never a hard dependency. Distinct from enable_firewall_management
# (router NAT forward vs. host ufw rule). Toggle with `instances config-set`.
enable_port_forwarding="${instance_enable_port_forwarding:-false}"

# Path to the firewall rule file
firewall_rule_file="${instance_firewall_rule_file}"

# Timeout in seconds for wget operations
wget_timeout_seconds="${config_wget_timeout_seconds:-60}"

#=============================================================================
# SERVER CONTROL COMMANDS
# Commands used to control the game server lifecycle
#=============================================================================

# Command to gracefully stop the server
stop_command="${instance_stop_command}"

# Command to save the game state
save_command="${instance_save_command}"

# Timeout in seconds to wait after sending save command
save_command_timeout_seconds="${instance_save_command_timeout_seconds}"

# Timeout in seconds to wait after sending stop command
stop_command_timeout_seconds="${instance_stop_command_timeout_seconds}"

# Player-moderation command templates (from the blueprint). Each carries exactly
# one placeholder — {ip}, {name} or {id} — naming the identity token this game
# expects; KGSM substitutes the caller's target into it and sends the result to
# the console. Empty = the game has no such command and the action is refused.
kick_command="${instance_kick_command}"
ban_command="${instance_ban_command}"
unban_command="${instance_unban_command}"

# Broadcast command template (from the blueprint). Carries exactly one
# {message} placeholder, which KGSM replaces with the announcement text before
# sending the result to the console. The placeholder may be the whole template,
# for a console that sends any bare line to chat. Empty = the game has no
# broadcast command and the announcement is refused.
broadcast_command="${instance_broadcast_command}"

#=============================================================================
# BACKUP CONFIGURATION
# Settings related to backup and data preservation
#=============================================================================

# Whether to compress backups to save space
compress_backups="${instance_compress_backups}"

#=============================================================================
# MANAGEMENT FEATURES
# Additional convenience and management features
#=============================================================================

# Whether to enable command shortcuts (symlinks) (true | false)
enable_command_shortcuts="${instance_enable_command_shortcuts:-false}"

# Path to the command shortcut file
command_shortcut_file="${instance_command_shortcut_file}"
