<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line layer: the `kgsm` binary, System.CommandLine over the engine core.
    It publishes as a clean Native-AOT binary:  dotnet publish src/Cli/Cli.csproj -c Release -r linux-x64
    It is also the host that generates the config descriptor from the core's settings class.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>kgsm</AssemblyName>
    <RootNamespace>TheKrystalShip.KGSM.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The generator that turns the settings file's keys into the descriptor needs these two files. -->
    <ComponentSettingsFile>kgsm.settings.json</ComponentSettingsFile>
    <ComponentDescriptorFile>$(MSBuildProjectDirectory)/kgsm.leaf.json</ComponentDescriptorFile>
    <!-- The actions the commands declare are the `kgsm` namespace's; the build writes them as the manifest
         beside the descriptor and as the constants the engine's callers name. -->
    <ComponentActionConstantsFile>$(MSBuildProjectDirectory)/../Engine.Contracts/Actions/EngineActions.g.cs</ComponentActionConstantsFile>
    <ComponentActionConstantsNamespace>TheKrystalShip.KGSM.Engine.Contracts</ComponentActionConstantsNamespace>
    <ComponentActionConstantsClass>EngineActions</ComponentActionConstantsClass>
    <ComponentActionConstantsComponent>kgsm</ComponentActionConstantsComponent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.ComponentConfig" Version="4.3.0" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TheKrystalShip.KGSM.Engine.Contracts.Reports" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.csproj" />
    <ProjectReference Include="../Engine.Contracts/Engine.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings file sits beside the binary; it is the lowest-precedence settings source. -->
    <Content Include="kgsm.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
