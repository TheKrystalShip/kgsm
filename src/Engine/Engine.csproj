<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TheKrystalShip.KGSM.Engine</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Engine</AssemblyName>
    <PackageId>TheKrystalShip.KGSM.Engine</PackageId>
    <Description>The KGSM engine core: paths, settings, blueprints, libraries, instances, backups, the event journal and locks.</Description>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The settings class is bound through the source-generated configuration binder, which a library
         has to switch on itself (an AOT publish switches it on for the application only). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- The source-generated libc imports (AppendOnlyFile) emit unsafe marshalling stubs; no hand-written
         unsafe code lives here. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The panel descriptor is generated by the host that publishes the binary (src/Cli); this project
         only declares the settings the descriptor is built from. -->
    <GenerateComponentDescriptor>false</GenerateComponentDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.ComponentConfig" Version="4.2.0" PrivateAssets="all" />
    <PackageReference Include="TheKrystalShip.KGSM.Watchdog.Client" Version="1.0.0-dev.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.11" />
    <!-- YamlDotNet ships no source generator of its own; without the analyzer the static context throws
         NotImplementedException at startup. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/management-script.tpl" LogicalName="management-script.tpl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Engine.Contracts/Engine.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>

</Project>
