#@if container
# =============================================================================
# CONTAINER: DOCKER
# =============================================================================

readonly REGISTRY_TIMEOUT_SECONDS=30
DOCKER_CHECKED=0

function _require_docker() {
  ((DOCKER_CHECKED)) && return 0

  if ! command -v docker >/dev/null 2>&1; then
    _err "docker is not installed"
    return 1
  fi

  if ! docker compose version >/dev/null 2>&1; then
    _err "docker compose is not available"
    return 1
  fi

  DOCKER_CHECKED=1
}

# docker compose against this instance's compose file.
function _compose() {
  _require_docker || return 1
  (cd "$instance_working_dir" && docker compose -f "$instance_compose_file" "$@")
}

# The number of this instance's services that are running, measured by compose.
function _running_services() {
  local json

  _require_docker || return 1
  [[ -f "$instance_compose_file" ]] || {
    echo 0
    return 0
  }

  if ! json="$(_compose ps --format json 2>/dev/null)"; then
    return 1
  fi

  [[ -n "$json" ]] || {
    echo 0
    return 0
  }
  jq -s 'flatten | map(select(.State == "running")) | length' <<<"$json"
}

function _console_fifo() {
  printf '%s' "${instance_events_dir}/command.fifo"
}

# A container's console pipe is served by the image's entrypoint, so it is only
# worth writing to while the container runs.
function _require_running_for_console() {
  if ! _is_active >/dev/null 2>&1; then
    _err "Container '${instance_name}' is not running"
    return $EC_ERROR
  fi
}

# Active or Inactive on compose's word, never on a file.
function _is_active() {
  local count

  if count="$(_running_services 2>/dev/null)" && [[ "$count" =~ ^[0-9]+$ ]] && ((count > 0)); then
    echo "Active"
    return $EC_SUCCESS
  fi

  rm -f "$instance_pid_file"
  echo "Inactive"
  return $EC_ERROR
}

function _container_id() {
  _compose ps -q 2>/dev/null | head -n1
}

# =============================================================================
# CONTAINER: VERSIONS, DOWNLOAD AND DEPLOY
#
# A container's version is the digest of the image or images its compose file
# resolves to. A tag is not a version: latest names a different image every
# time upstream pushes.
# =============================================================================

function _compose_images() {
  local images

  images="$(_compose config --images 2>/dev/null)" || return 1
  [[ -n "$images" ]] || return 1
  printf '%s\n' "$images"
}

# Reduces per-image digests (one per line on stdin) to one string. One image
# gives its full digest; several give their sorted short digests joined by +.
function _fingerprint_digests() {
  local -a digests=() short=()
  local line digest joined="" part

  while IFS= read -r line; do
    [[ -n "$line" ]] && digests+=("$line")
  done

  case ${#digests[@]} in
  0) return 1 ;;
  1) printf '%s\n' "${digests[0]}" ;;
  *)
    while IFS= read -r digest; do
      short+=("${digest#sha256:}")
    done < <(printf '%s\n' "${digests[@]}" | sort)

    for part in "${short[@]}"; do
      joined+="${joined:++}${part:0:12}"
    done
    printf '%s\n' "$joined"
    ;;
  esac
}

# The digest the registry serves for every image, right now. Every image must
# answer: a partial reading is not a version.
function _latest_version() {
  local images image digest
  local -a digests=()

  if ! images="$(_compose_images)"; then
    _err "Could not resolve the images in ${instance_compose_file}"
    return 1
  fi

  while IFS= read -r image; do
    [[ -n "$image" ]] || continue
    digest="$(timeout "$REGISTRY_TIMEOUT_SECONDS" docker buildx imagetools inspect "$image" \
      --format '{{.Manifest.Digest}}' 2>/dev/null)"
    if [[ "$digest" != sha256:* ]]; then
      _err "The registry did not answer for image '${image}'"
      return 1
    fi
    digests+=("$digest")
  done <<<"$images"

  printf '%s\n' "${digests[@]}" | _fingerprint_digests
}

# The digest each image resolves to on this host: what was really pulled.
function _local_version() {
  local images image repo_digest digest
  local -a digests=()

  images="$(_compose_images)" || return 1

  while IFS= read -r image; do
    [[ -n "$image" ]] || continue
    repo_digest="$(docker image inspect "$image" \
      --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' 2>/dev/null)"
    digest="${repo_digest#*@}"
    [[ "$digest" == sha256:* ]] || return 1
    digests+=("$digest")
  done <<<"$images"

  printf '%s\n' "${digests[@]}" | _fingerprint_digests
}

# download: pull the images.
function _download() {
  _info "Pulling images..."
  if ! _compose pull; then
    _err "Failed to pull Docker images"
    return $EC_ERROR
  fi
  _success "Download complete"
}

# deploy: a container is defined by its compose file, so there is nothing to place.
function _deploy() {
  _info "Nothing to deploy for a container"
}

# =============================================================================
# CONTAINER: PROCESSES
# =============================================================================

# start -d: bring the project up detached and record the container id.
function _start_background() {
  local id

  if _is_active >/dev/null 2>&1; then
    _err "Instance '${instance_name}' is already running"
    return $EC_ERROR
  fi

  if ! _rotate_log_file; then
    _err "Failed to rotate the log file; aborting to prevent data loss"
    return $EC_ERROR
  fi

  if [[ "$instance_auto_update_before_start" == "true" ]]; then
    if ! _update --run-state inactive >/dev/null; then
      _err "Failed to update ${instance_name}; not starting"
      return $EC_ERROR
    fi
  fi

  if ! _compose up -d; then
    _err "Failed to start the container"
    return $EC_ERROR
  fi

  id="$(_container_id)"
  if [[ -z "$id" ]]; then
    _err "Failed to get the container id after starting"
    return $EC_ERROR
  fi

  printf '%s\n' "$id" >"$instance_pid_file"
  _success "Instance ${instance_name} started in container ${id}"
}

# start: the project in the foreground.
function _start() {
  if _is_active >/dev/null 2>&1; then
    _err "Instance '${instance_name}' is already running"
    return $EC_ERROR
  fi

  _rotate_log_file || _warn "Failed to rotate the log file, continuing"

  if [[ "$instance_auto_update_before_start" == "true" ]]; then
    if ! _update --run-state inactive >/dev/null; then
      _err "Failed to update ${instance_name}; not starting"
      return $EC_ERROR
    fi
  fi

  printf '%s\n' "$$" >"$instance_pid_file"
  _compose up
  local rc=$?
  rm -f "$instance_pid_file"
  return $rc
}

# Records that the instance is stopping on the host-visible lifecycle channel
# before the container is torn down. Best effort: it never fails the stop.
function _emit_stopping() {
  local ts

  mkdir -p "$instance_events_dir" 2>/dev/null || return 0
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")" || return 0
  printf '{"type":"instance_stopping","ts":"%s"}\n' "$ts" \
    >>"${instance_events_dir}/lifecycle.ndjson" 2>/dev/null || true
}

# Waits until no service runs or the seconds pass.
function _wait_stopped() {
  local seconds="$1" deadline count

  deadline=$(($(_now_ms) + seconds * 1000))
  while :; do
    count="$(_running_services 2>/dev/null)" || return 1
    ((count == 0)) && return 0
    (($(_now_ms) >= deadline)) && return 1
    sleep 0.2
  done
}

# stop [--no-save] [--no-graceful]: the save command, the stop command through
# the command pipe, a wait of the stop timeout, then compose down, which sends
# TERM and KILLs after the grace period.
function _stop_server() {
  local save=1 graceful=1 arg sent=0
  local timeout="$instance_stop_command_timeout_seconds"

  for arg in "$@"; do
    case "$arg" in
    --no-save) save=0 ;;
    --no-graceful) graceful=0 ;;
    *)
      _err "Invalid argument: ${arg}"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  if ! _is_active >/dev/null 2>&1; then
    _info "Instance '${instance_name}' is not running"
    return $EC_SUCCESS
  fi

  _info "Stopping ${instance_name}"

  if ((save)); then
    _send_save_command || _warn "The save command did not reach the container"
  fi

  if ((graceful)) && [[ -n "${instance_stop_command:-}" ]]; then
    if _write_console_line "$instance_stop_command"; then
      sent=1
    else
      _warn "The stop command did not reach the container"
    fi
  fi

  if ((sent)); then
    _wait_stopped "$timeout" || _warn "The container did not exit ${timeout} s after its stop command"
  fi

  _emit_stopping

  if ! _compose down --timeout "$KGSM_TERM_GRACE_SECONDS"; then
    _err "Failed to stop the container with compose down"
    return $EC_ERROR
  fi

  rm -f "$instance_pid_file"
  _success "Instance '${instance_name}' stopped"
}

function _restart() {
  _stop_server || return $?
  _start_background
}

# kill: kill the container, falling back to compose, then remove what is left.
function _kill_all_processes() {
  local id

  _info "Killing the container..."
  id="$(_container_id)"

  if [[ -n "$id" ]]; then
    if ! docker kill "$id" >/dev/null 2>&1; then
      _warn "docker kill failed; trying compose kill"
      if ! _compose kill; then
        _err "Compose kill also failed"
        return $EC_ERROR
      fi
    fi
  fi

  _compose down --remove-orphans >/dev/null 2>&1 || _warn "Failed to clean up the container's resources"
  rm -f "$instance_pid_file"
  _success "Container killed"
}

# attach: a shell inside the running container.
function _attach() {
  local service

  if ! _is_active >/dev/null 2>&1; then
    _err "Cannot attach: ${instance_name} is not running"
    return $EC_ERROR
  fi

  service="$(_compose config --services 2>/dev/null | head -n1)"
  if [[ -z "$service" ]]; then
    _err "The compose file defines no service"
    return $EC_ERROR
  fi

  _compose exec "$service" /bin/sh
}

# =============================================================================
# CONTAINER: STATUS
# =============================================================================

# Sets STATUS_PID (the container's init process on the host), STATUS_STATE and
# STATUS_START from docker inspect.
function _process_facts() {
  local id info state pid started

  STATUS_PID=""
  STATUS_STATE=""
  STATUS_START=""

  id="$(_container_id)"
  [[ -n "$id" ]] || return 0

  info="$(docker inspect "$id" --format '{{.State.Status}} {{.State.Pid}} {{.State.StartedAt}}' 2>/dev/null)" || return 0
  read -r state pid started <<<"$info"
  STATUS_STATE="$state"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] && STATUS_PID="$pid"
  STATUS_START="$(_to_iso_utc "$started")"
}

function _recent_logs_json() {
  local lines

  if _is_active >/dev/null 2>&1; then
    lines="$(_compose logs --no-color --tail=3 2>/dev/null)"
  else
    local source
    source="$(_recent_log_source)"
    lines=""
    [[ -n "$source" ]] && lines="$(tail -n 3 "$source" 2>/dev/null)"
  fi

  if [[ -z "$lines" ]]; then
    echo '[]'
    return 0
  fi

  printf '%s\n' "$lines" | jq -R -s -c 'rtrimstr("\n") | split("\n")'
}

# The container's id and what docker measures of its resources.
function _status_extra() {
  local id resources

  id="$(_container_id)"
  [[ -n "$id" ]] || return 0
  echo "Container ID: ${id}"

  resources="$(docker stats --no-stream \
    --format 'CPU: {{.CPUPerc}}, Memory: {{.MemUsage}} ({{.MemPerc}}), PIDs: {{.PIDs}}' "$id" 2>/dev/null)"
  [[ -n "$resources" ]] && echo "Resources: ${resources}"
  return 0
}
#@end

# =============================================================================
# BACKUPS
#
# A backup is a directory <backups>/<id>/ holding manifest.json and either
# data.tar.gz or data/. It is built in a hidden staging directory beside its
# final place and renamed into it, so a listing never shows a partial backup.
# =============================================================================

readonly BACKUP_SOURCE_LABELS=(install saves)
readonly BACKUP_REASONS=(manual scheduled pre-update pre-restore incident)
readonly BACKUP_RETENTIONS=(prunable pinned)
readonly BACKUP_SCHEMA=1

function _is_one_of() {
  local needle="$1" candidate
  shift

  for candidate in "$@"; do
    [[ "$candidate" == "$needle" ]] && return 0
  done
  return 1
}

# A run state is what the caller knows about the instance: it is running, it is
# not, or nobody can say.
function _check_run_state() {
  [[ -z "$1" ]] && return 0
  if ! _is_one_of "$1" active inactive unknown; then
    _err "Unknown run state '$1' (one of: active inactive unknown)"
    return 1
  fi
}

# A backup id is the directory name, so it holds no path.
function _valid_backup_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

# The subtrees of this instance that hold something, one per line.
function _backup_sources() {
  local label dir

  for label in "${BACKUP_SOURCE_LABELS[@]}"; do
    dir="${instance_working_dir}/${label}"
    [[ -d "$dir" ]] || continue
    _dir_has_files "$dir" || continue
    echo "$label"
  done
}

function _new_backup_id() {
  local stamp suffix

  stamp="$(date -u +"%Y%m%dT%H%M%SZ")"
  suffix="$(od -An -tx1 -N3 /dev/urandom 2>/dev/null | tr -d ' \n')"
  [[ -n "$suffix" ]] || suffix="$(printf '%06x' $((RANDOM * RANDOM % 16777216)))"
  echo "${instance_name}-${stamp}-${suffix}"
}

# create-backup [--run-state active|inactive|unknown] [--reason R] [--retention P]
# Prints the new backup's id as the last line of stdout.
function _create_backup() {
  local run_state="" reason="manual" retention="prunable"
  local flushed=0 consistency compressed=false size_bytes=0 sha256="" file_count=0
  local backup_id staging label count version
  local -a sources=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --run-state)
      run_state="${2:-}"
      shift 2 || break
      ;;
    --reason)
      reason="${2:-}"
      shift 2 || break
      ;;
    --retention)
      retention="${2:-}"
      shift 2 || break
      ;;
    *)
      _err "Invalid argument: $1"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  if ! _is_one_of "$reason" "${BACKUP_REASONS[@]}"; then
    _err "Unknown backup reason '${reason}' (one of: ${BACKUP_REASONS[*]})"
    return $EC_INVALID_ARG
  fi

  if ! _is_one_of "$retention" "${BACKUP_RETENTIONS[@]}"; then
    _err "Unknown backup retention '${retention}' (one of: ${BACKUP_RETENTIONS[*]})"
    return $EC_INVALID_ARG
  fi

  _check_run_state "$run_state" || return $EC_INVALID_ARG

  if [[ -z "$instance_backups_dir" ]]; then
    _err "The config names no backups directory"
    return $EC_ERROR
  fi

  if [[ -z "$run_state" ]]; then
    if _is_active >/dev/null 2>&1; then
      run_state="active"
    else
      run_state="inactive"
    fi
  fi

  _info "Creating backup..."

  # Some games declare one token for both save and stop, which would shut the
  # server down to back it up; that is not a usable save command.
  if [[ "$run_state" == "active" && -n "${instance_save_command:-}" &&
    "$instance_save_command" != "${instance_stop_command:-}" ]]; then
    if _send_save_command; then
      flushed=1
    else
      _warn "The save command failed; archiving without a flush"
    fi
  fi

  case "$run_state" in
  inactive) consistency="cold" ;;
  active) ((flushed)) && consistency="flushed" || consistency="hot" ;;
  *) consistency="" ;;
  esac

  mapfile -t sources < <(_backup_sources)

  # A running instance rewrites saves/ but not install/, which is the bulk of a
  # game and can be downloaded again. Capturing saves alone keeps a frequent
  # cadence affordable, and holds only while saves/ has content.
  if [[ "$run_state" == "active" ]]; then
    for label in "${sources[@]}"; do
      if [[ "$label" == "saves" ]]; then
        sources=(saves)
        break
      fi
    done
  fi

  if [[ ${#sources[@]} -eq 0 ]]; then
    _err "Nothing to back up for ${instance_name}: install and saves are empty"
    return $EC_ERROR
  fi

  if ! mkdir -p "$instance_backups_dir"; then
    _err "Failed to create ${instance_backups_dir}"
    return $EC_ERROR
  fi

  backup_id="$(_new_backup_id)"
  staging="${instance_backups_dir}/.${backup_id}.partial"

  if ! mkdir -p "$staging"; then
    _err "Failed to create the staging directory ${staging}"
    return $EC_ERROR
  fi

  if [[ "$instance_compress_backups" == "true" ]]; then
    compressed=true
    if ! tar -czf "${staging}/data.tar.gz" -C "$instance_working_dir" "${sources[@]}"; then
      _err "Failed to archive ${sources[*]}"
      rm -rf "${staging:?}"
      return $EC_ERROR
    fi
    size_bytes="$(stat -c %s "${staging}/data.tar.gz" 2>/dev/null || echo 0)"
    sha256="$(sha256sum "${staging}/data.tar.gz" | cut -d' ' -f1)"
  else
    if ! mkdir -p "${staging}/data"; then
      _err "Failed to create the staging data directory"
      rm -rf "${staging:?}"
      return $EC_ERROR
    fi
    for label in "${sources[@]}"; do
      if ! cp -a "${instance_working_dir}/${label}" "${staging}/data/${label}"; then
        _err "Failed to copy ${label}"
        rm -rf "${staging:?}"
        return $EC_ERROR
      fi
    done
    size_bytes="$(du -sb "${staging}/data" 2>/dev/null | cut -f1)"
  fi

  for label in "${sources[@]}"; do
    count="$(find "${instance_working_dir}/${label}" -type f 2>/dev/null | wc -l)"
    file_count=$((file_count + count))
  done

  version="$(_installed_version)"
  [[ "$version" == "unknown" ]] && version=""

  if ! jq -nc \
    --argjson schema "$BACKUP_SCHEMA" \
    --arg id "$backup_id" \
    --arg instance "$instance_name" \
    --arg blueprint "$instance_blueprint" \
    --arg version "$version" \
    --arg created "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
    --arg reason "$reason" \
    --arg retention "$retention" \
    --argjson compressed "$compressed" \
    --arg consistency "$consistency" \
    --arg sha256 "$sha256" \
    --argjson size "${size_bytes:-0}" \
    --argjson files "$file_count" \
    '{
      schemaVersion: $schema,
      id: $id,
      instance: $instance,
      blueprint: (if $blueprint == "" then null else $blueprint end),
      version: (if $version == "" then null else $version end),
      createdAt: $created,
      reason: $reason,
      retention: $retention,
      compressed: $compressed,
      consistency: (if $consistency == "" then null else $consistency end),
      sources: $ARGS.positional,
      sizeBytes: $size,
      fileCount: $files,
      sha256: (if $sha256 == "" then null else $sha256 end)
    }' --args "${sources[@]}" >"${staging}/manifest.json"; then
    _err "Failed to write the backup manifest"
    rm -rf "${staging:?}"
    return $EC_ERROR
  fi

  # Until this rename the backup does not exist as far as any listing goes.
  if ! mv "$staging" "${instance_backups_dir}/${backup_id}"; then
    _err "Failed to publish the backup to ${instance_backups_dir}/${backup_id}"
    rm -rf "${staging:?}"
    return $EC_ERROR
  fi

  _success "Backup created: ${backup_id}"
  echo "$backup_id"
}

# Every readable backup's manifest as a JSON array, newest first. A directory
# without a readable manifest of a known schema, or whose manifest names another
# id, is not a backup. An absent retention reads as prunable and an absent
# reason as null.
function _backup_manifests_json() {
  local dir id manifest

  if [[ -z "$instance_backups_dir" || ! -d "$instance_backups_dir" ]]; then
    echo "[]"
    return 0
  fi

  for dir in "$instance_backups_dir"/*/; do
    [[ -d "$dir" ]] || continue
    dir="${dir%/}"
    id="${dir##*/}"
    manifest="${dir}/manifest.json"
    [[ -f "$manifest" ]] || continue
    jq -c --arg id "$id" --argjson schema "$BACKUP_SCHEMA" \
      'select(type == "object" and .schemaVersion == $schema and .id == $id)
       | .reason = (.reason // null)
       | .retention = (.retention // "prunable")' "$manifest" 2>/dev/null
  done | jq -sc 'sort_by([.createdAt, .id]) | reverse'
}

# The ids, newest first.
function _list_backups() {
  _backup_manifests_json | jq -r '.[].id'
}

# restore-backup <id> [--run-state S]: verify first, take a pre-restore safety
# backup of what is there and abort if that fails, then replace each captured
# subtree.
function _restore_backup() {
  local backup_id="$1" source manifest compressed expected actual version label
  local run_state="" has_content=0 safety_id
  local -a sources=() safety=()
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --run-state)
      run_state="${2:-}"
      shift 2 || break
      ;;
    *)
      _err "Invalid argument: $1"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  if ! _valid_backup_id "$backup_id"; then
    _err "Invalid backup id '${backup_id}'"
    return $EC_INVALID_ARG
  fi

  source="${instance_backups_dir}/${backup_id}"
  manifest="${source}/manifest.json"
  _info "Restoring ${backup_id}..."

  if [[ ! -f "$manifest" ]]; then
    _err "Not a backup: ${source} (no manifest.json)"
    return $EC_NOT_FOUND
  fi

  if ! jq -e --argjson schema "$BACKUP_SCHEMA" 'type == "object" and .schemaVersion == $schema' "$manifest" >/dev/null 2>&1; then
    _err "The manifest of ${backup_id} is unreadable or of a schemaVersion this script does not know"
    return $EC_ERROR
  fi

  version="$(jq -r '.version // ""' "$manifest")"
  compressed="$(jq -r '.compressed' "$manifest")"
  expected="$(jq -r '.sha256 // ""' "$manifest")"
  mapfile -t sources < <(jq -r '.sources[]' "$manifest")

  if [[ ${#sources[@]} -eq 0 ]]; then
    _err "Backup ${backup_id} records no sources; refusing to restore"
    return $EC_ERROR
  fi

  for label in "${sources[@]}"; do
    if ! _is_one_of "$label" "${BACKUP_SOURCE_LABELS[@]}"; then
      _err "Backup ${backup_id} names the source '${label}'; refusing to restore"
      return $EC_ERROR
    fi
  done

  # A corrupt backup must fail while the current state is still intact.
  if [[ "$compressed" == "true" ]]; then
    if [[ ! -f "${source}/data.tar.gz" ]]; then
      _err "Backup ${backup_id} is marked compressed but has no data.tar.gz"
      return $EC_ERROR
    fi
    if [[ -n "$expected" ]]; then
      _info "Verifying backup integrity..."
      actual="$(sha256sum "${source}/data.tar.gz" | cut -d' ' -f1)"
      if [[ "$actual" != "$expected" ]]; then
        _err "Checksum mismatch for ${backup_id}; refusing to restore"
        return $EC_ERROR
      fi
    fi
  elif [[ ! -d "${source}/data" ]]; then
    _err "Backup ${backup_id} is marked uncompressed but has no data directory"
    return $EC_ERROR
  fi

  for label in "${sources[@]}"; do
    if [[ -d "${instance_working_dir}/${label}" ]] && _dir_has_files "${instance_working_dir}/${label}"; then
      has_content=1
      break
    fi
  done

  # A restore must never be the reason data is lost.
  if ((has_content)); then
    _warn "The current data is not empty; taking a safety backup first"
    safety=(--reason pre-restore)
    [[ -n "$run_state" ]] && safety+=(--run-state "$run_state")
    if ! safety_id="$(_create_backup "${safety[@]}" | tail -n1)" || [[ -z "$safety_id" || ! -f "${instance_backups_dir}/${safety_id}/manifest.json" ]]; then
      _err "Failed to take a backup before the restore; aborting to prevent data loss"
      return $EC_ERROR
    fi
    _info "Safety backup: ${safety_id}"
  fi

  for label in "${sources[@]}"; do
    if ! mkdir -p "${instance_working_dir}/${label}" || ! _clear_dir "${instance_working_dir}/${label}"; then
      _err "Failed to clear ${instance_working_dir}/${label}"
      return $EC_ERROR
    fi
  done

  if [[ "$compressed" == "true" ]]; then
    if ! tar -xzf "${source}/data.tar.gz" -C "$instance_working_dir" "${sources[@]}"; then
      _err "Failed to extract ${backup_id}"
      return $EC_ERROR
    fi
  else
    for label in "${sources[@]}"; do
      if ! cp -a "${source}/data/${label}/." "${instance_working_dir}/${label}/"; then
        _err "Failed to restore ${label} from ${backup_id}"
        return $EC_ERROR
      fi
    done
  fi

  # The manifest carries the version; a backup that recorded none leaves the
  # installed version unknown.
  if [[ -n "$version" ]]; then
    _save_version "$version" || return $EC_ERROR
  else
    rm -f "$instance_version_file"
  fi

  _success "Restore complete"
}

# pin-backup / unpin-backup: set a backup's retention in place. The new manifest
# is staged beside the old and renamed, so a failure leaves the backup as it
# was. The reason is a fact about how the archive was produced and is never
# rewritten.
function _set_backup_retention() {
  local backup_id="$1" retention="$2" manifest staged

  if [[ -z "$backup_id" ]]; then
    _err "Missing backup id"
    return $EC_MISSING_ARG
  fi

  if ! _valid_backup_id "$backup_id"; then
    _err "Invalid backup id '${backup_id}'"
    return $EC_INVALID_ARG
  fi

  if ! _is_one_of "$retention" "${BACKUP_RETENTIONS[@]}"; then
    _err "Unknown backup retention '${retention}' (one of: ${BACKUP_RETENTIONS[*]})"
    return $EC_INVALID_ARG
  fi

  manifest="${instance_backups_dir}/${backup_id}/manifest.json"
  if [[ ! -f "$manifest" ]]; then
    _err "Not a backup: ${instance_backups_dir}/${backup_id} (no manifest.json)"
    return $EC_NOT_FOUND
  fi

  staged="${manifest}.staged"
  if ! jq -c --arg retention "$retention" \
    '. + {schemaVersion: 1, reason: (.reason // null), retention: $retention}' \
    "$manifest" >"$staged" 2>/dev/null; then
    _err "Failed to rewrite the manifest of ${backup_id}"
    rm -f "$staged"
    return $EC_ERROR
  fi

  if ! mv "$staged" "$manifest"; then
    _err "Failed to publish the manifest of ${backup_id}"
    rm -f "$staged"
    return $EC_ERROR
  fi

  _success "${backup_id}: retention ${retention}"
}

# =============================================================================
# STATUS
# =============================================================================

# status [--json] [--fast]: without --fast upstream is asked, and the moment of
# that fetch is the check's time; with --fast only the latest-version record is
# read. Nothing recorded means unchecked, never up to date.
function _status() {
  local json="" fast="" arg
  local current latest="" checked=false available="" checked_at="" outcome
  local disk="" backups_json logs_json

  for arg in "$@"; do
    case "$arg" in
    --json) json=1 ;;
    --fast) fast=1 ;;
    *)
      _err "Invalid argument: ${arg}"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  local active=false
  if _is_active >/dev/null 2>&1; then
    active=true
    _process_facts
  else
    STATUS_PID=""
    STATUS_STATE=""
    STATUS_START=""
  fi

  current="$(_installed_version)"
  [[ "$current" == "unknown" ]] && current=""

  if [[ -n "$fast" ]]; then
    latest="$(_stored_latest_version)"
    if [[ -n "$latest" ]]; then
      checked=true
      checked_at="$(_stored_latest_checked_at)"
    fi
  elif outcome="$(_version_check 2>/dev/null)"; then
    latest="${outcome#* }"
    checked=true
    checked_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  fi

  if [[ "$checked" == "true" && -n "$current" ]]; then
    [[ "$current" == "$latest" ]] && available=false || available=true
  fi

  if [[ -d "$instance_working_dir" ]]; then
    disk="$(du -sb "$instance_working_dir" 2>/dev/null | cut -f1)"
  fi

  backups_json="$(_backup_manifests_json | jq -c '[.[].id]')"
  logs_json="$(_recent_logs_json)"

  if [[ -n "$json" ]]; then
    jq -nc \
      --arg name "$instance_name" \
      --argjson active "$active" \
      --arg pid "$STATUS_PID" \
      --arg pstate "$STATUS_STATE" \
      --arg start "$STATUS_START" \
      --arg current "$current" \
      --arg latest "$latest" \
      --argjson checked "$checked" \
      --arg available "$available" \
      --arg checked_at "$checked_at" \
      --arg blueprint "$instance_blueprint" \
      --arg runtime "$instance_runtime" \
      --arg directory "$instance_working_dir" \
      --arg ports "${instance_ports:-}" \
      --arg disk "$disk" \
      --argjson backups "$backups_json" \
      --argjson logs "$logs_json" \
      '{
        instanceName: $name,
        status: $active,
        process: {
          pid: (if $pid != "" then ($pid | tonumber) else null end),
          status: (if $pstate != "" then $pstate else null end),
          startTime: (if $start != "" then $start else null end)
        },
        version: {
          current: (if $current != "" then $current else null end),
          latest: (if $latest != "" then $latest else null end),
          checked: $checked,
          updatesAvailable: (if $available != "" then ($available == "true") else null end),
          checkedAt: (if $checked_at != "" then $checked_at else null end)
        },
        configuration: {
          blueprint: $blueprint,
          runtime: $runtime,
          directory: $directory,
          ports: (if $ports != "" then $ports else null end)
        },
        resources: {
          diskUsageBytes: (if $disk != "" then ($disk | tonumber) else null end)
        },
        backups: $backups,
        recentLogs: $logs
      }'
    return 0
  fi

  echo "=== Instance Status: ${instance_name} ==="
  if [[ "$active" == "true" ]]; then
    echo "Status: Active"
    [[ -n "$STATUS_PID" ]] && echo "Process ID: ${STATUS_PID}"
    [[ -n "$STATUS_STATE" ]] && echo "Process Status: ${STATUS_STATE}"
    [[ -n "$STATUS_START" ]] && echo "Start Time: ${STATUS_START}"
    _status_extra
  else
    echo "Status: Inactive"
  fi

  echo "Version: ${current:-unknown}"
  if [[ "$checked" != "true" ]]; then
    if [[ -n "$fast" ]]; then
      echo "Updates: Not checked (fast mode)"
    else
      echo "Updates: Not checked"
    fi
  elif [[ "$available" == "true" ]]; then
    echo "Updates: Available (Latest: ${latest})"
  elif [[ "$available" == "false" ]]; then
    echo "Updates: Up to date"
  else
    echo "Updates: Latest is ${latest}"
  fi

  echo "Blueprint: ${instance_blueprint}"
  echo "Runtime: ${instance_runtime}"
  echo "Directory: ${instance_working_dir}"
  [[ -n "${instance_ports:-}" ]] && echo "Ports: ${instance_ports}"
  [[ -n "$disk" ]] && echo "Disk Usage: ${disk} bytes"

  echo "Backups:"
  if [[ "$backups_json" == "[]" ]]; then
    echo "  No backups available"
  else
    jq -r '.[]' <<<"$backups_json" | sed 's/^/  /'
  fi

  echo ""
  echo "Recent Activity:"
  if [[ "$logs_json" == "[]" ]]; then
    echo "  No recent logs available"
  else
    jq -r '.[]' <<<"$logs_json" | sed 's/^/  /'
  fi
}

# =============================================================================
# UPDATE
# =============================================================================

#@if native
# update [--run-state S] [--emit-cmd "<command>"]: refuse while running, stop
# when already current, take a pre-update backup (and abort if it fails), then
# download, deploy and record the version. Prints "updated <version>" or
# "current <version>". Each phase is reported through the emit command as
# <command> <phase> <instance>.
function _update() {
  local run_state="" backup_id latest installed
  local -a backup_args=(--reason pre-update)

  EMIT_CMD=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --run-state)
      run_state="${2:-}"
      shift 2 || break
      ;;
    --emit-cmd)
      read -r -a EMIT_CMD <<<"${2:-}"
      shift 2 || break
      ;;
    *)
      _err "Invalid argument: $1"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  _check_run_state "$run_state" || return $EC_INVALID_ARG

  _info "Starting update..."

  # Deploying over a running game copies onto its own open executable and
  # fails partway, leaving install/ half replaced.
  if [[ "$run_state" == "active" ]] || _is_active >/dev/null 2>&1; then
    _err "${instance_name} is running; stop it before updating"
    return $EC_ERROR
  fi

  if ! latest="$(_latest_version)"; then
    _err "The latest version could not be determined; not updating"
    return $EC_ERROR
  fi

  installed="$(_installed_version)"
  if [[ "$latest" == "$installed" ]]; then
    _info "Already up to date (version ${installed})"
    echo "current ${installed}"
    return $EC_SUCCESS
  fi

  # Everything past this point overwrites the installed game, and for several
  # games the world lives in install/. A capture that fails abandons the update.
  [[ -n "$run_state" ]] && backup_args+=(--run-state "$run_state")
  if ! backup_id="$(_create_backup "${backup_args[@]}" | tail -n1)" || [[ -z "$backup_id" ]]; then
    _err "The backup before the update failed; leaving ${instance_name} on version ${installed}"
    return $EC_ERROR
  fi
  _success "Backup before update: ${backup_id}"

  _emit_phase server.download.started
  if ! _download "$latest"; then
    _emit_phase server.download.failed
    _err "Failed to download version ${latest}"
    return $EC_ERROR
  fi
  _emit_phase server.download.finished

  _emit_phase server.deploy.started
  if ! _deploy; then
    _emit_phase server.deploy.failed
    _err "Failed to deploy version ${latest}"
    return $EC_ERROR
  fi
  _emit_phase server.deploy.finished

  if ! _save_version "$latest"; then
    _err "Failed to record version ${latest}"
    return $EC_ERROR
  fi

  _success "Update complete, new version: ${latest}"
  echo "updated ${latest}"
}
#@end
#@if container
# Puts the pulled images behind the containers. A running instance is
# recreated; a stopped one has its containers created without starting the
# game.
function _recreate() {
  if [[ "$1" == "active" ]] || _is_active >/dev/null 2>&1; then
    _compose up -d --force-recreate
  else
    _compose create
  fi
}

# update [--run-state S] [--emit-cmd "<command>"]: a pre-update backup (abort if
# it fails), then pull, recreate the containers on the new images and record
# the digest of what was pulled. Prints "updated <version>". Each phase is
# reported through the emit command as <command> <phase> <instance>.
function _update() {
  local run_state="" backup_id pulled
  local -a backup_args=(--reason pre-update)

  EMIT_CMD=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --run-state)
      run_state="${2:-}"
      shift 2 || break
      ;;
    --emit-cmd)
      read -r -a EMIT_CMD <<<"${2:-}"
      shift 2 || break
      ;;
    *)
      _err "Invalid argument: $1"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  _check_run_state "$run_state" || return $EC_INVALID_ARG

  _info "Updating the container..."

  [[ -n "$run_state" ]] && backup_args+=(--run-state "$run_state")
  if ! backup_id="$(_create_backup "${backup_args[@]}" | tail -n1)" || [[ -z "$backup_id" ]]; then
    _err "The backup before the update failed; not updating ${instance_name}"
    return $EC_ERROR
  fi
  _success "Backup before update: ${backup_id}"

  _emit_phase server.download.started
  if ! _compose pull; then
    _emit_phase server.download.failed
    _err "Failed to pull the images"
    return $EC_ERROR
  fi
  _emit_phase server.download.finished

  _emit_phase server.deploy.started
  if ! _recreate "$run_state"; then
    _emit_phase server.deploy.failed
    _err "Failed to recreate the containers on the pulled images"
    return $EC_ERROR
  fi
  _emit_phase server.deploy.finished

  # Record what was pulled, read back from Docker. A version that cannot be read
  # leaves none recorded, which reads as unchecked and is true.
  if pulled="$(_local_version)"; then
    _save_version "$pulled" || return $EC_ERROR
  else
    _warn "Could not read the digest of the pulled images; recording no version"
    rm -f "$instance_version_file"
    echo "updated unknown"
    return $EC_SUCCESS
  fi

  _success "Update complete"
  echo "updated ${pulled}"
}
#@end

# =============================================================================
# LOGS
# =============================================================================

#@if native
function _print_logs() {
  local follow="$1" lines="$2"

  if [[ ! -f "$instance_log_file" ]]; then
    _info "No log file found at '${instance_log_file}'"
    return $EC_SUCCESS
  fi

  if [[ "$follow" == "true" ]]; then
    exec tail -n "$lines" -F "$instance_log_file"
  fi
  tail -n "$lines" "$instance_log_file"
}
#@end
#@if container
function _print_logs() {
  local follow="$1" lines="$2"

  if [[ "$follow" == "true" ]]; then
    _compose logs --tail="$lines" -f
    return $?
  fi
  _compose logs --tail="$lines"
}
#@end

#@hooks

# =============================================================================
# HELP
# =============================================================================

function _usage() {
  cat <<EOF
Instance management - ${instance_name}

Usage:
  ${self} <command> [arguments] [options]

Lifecycle:
  start [-d, --detached]            Start the server
  stop [--no-save] [--no-graceful]  Stop the server
  restart                           Stop, then start
  attach                            Attach to the running server
  kill                              End the server at once
  is-active                         Print Active or Inactive

Server:
  save                              Save the game state
  input <command>                   Send a command to the console
  announce <message>                Broadcast a message to the players
  kick|ban|unban <target>           Player moderation
  status [--json] [--fast]          Run state, version, backups and recent output
  logs [-f] [-n N]                  View the server log
#@if native
  launch-args [--null]              Print the resolved launch arguments
#@end
  script-info                       Print the template version, hooks digest and runtime

Versions and updates:
  version [--compare|--latest|--save <v>|--stored-latest|--stored-checked-at|--save-latest <v>]
  check-update                      Print available <v>, current <v> or unknown
  download [version]                Fetch the game files
  deploy                            Place the fetched files
  update [--run-state S] [--emit-cmd C]

Backups:
  backups [--json]                  List backup ids, newest first
  create-backup [--run-state S] [--reason R] [--retention P]
  restore-backup <id> [--run-state S]
  pin-backup <id> | unpin-backup <id>
  backup create|restore <id>|list

Other:
  help [command]                    This help
EOF
}

function _usage_command() {
  case "$1" in
  start) echo "Usage: ${self} start [-d|--detached]
Starts the server. Without -d it starts in the background and attaches." ;;
  stop) echo "Usage: ${self} stop [--no-save] [--no-graceful]
Saves, sends the stop command, waits the stop timeout, then ends the process with TERM and KILL.
--no-save skips the save; --no-graceful skips both and ends the process at once." ;;
  restart) echo "Usage: ${self} restart
Stops the server, then starts it in the background." ;;
  attach) echo "Usage: ${self} attach
Follows the log and sends the lines you type to the console. .detach leaves; Ctrl+C stops the server." ;;
  status) echo "Usage: ${self} status [--json] [--fast]
--fast reads the recorded latest version and asks upstream nothing." ;;
  logs) echo "Usage: ${self} logs [-f|--follow] [-n|--tail|--lines N]" ;;
  version) echo "Usage: ${self} version [--compare|--latest|--save <v>|--stored-latest|--stored-checked-at|--save-latest <v>]
Without options prints the installed version, or unknown." ;;
  check-update) echo "Usage: ${self} check-update
Prints 'available <version>', 'current <version>' or 'unknown'. Exits 1 only for unknown." ;;
  download) echo "Usage: ${self} download [version]" ;;
  deploy) echo "Usage: ${self} deploy" ;;
  update) echo "Usage: ${self} update [--run-state active|inactive|unknown] [--emit-cmd <command>]
Prints 'updated <version>' or 'current <version>'." ;;
  announce) echo "Usage: ${self} announce <message>" ;;
  kick | ban | unban) echo "Usage: ${self} $1 <target>" ;;
  backup | backups | create-backup | restore-backup | pin-backup | unpin-backup)
    echo "Usage: ${self} backups [--json]
       ${self} create-backup [--run-state S] [--reason manual|scheduled|pre-update|pre-restore|incident] [--retention prunable|pinned]
       ${self} restore-backup <id> [--run-state S]
       ${self} pin-backup <id> | unpin-backup <id>" ;;
#@if native
  launch-args) echo "Usage: ${self} launch-args [--null]
Prints the resolved launch arguments, one per line, or NUL-separated with --null." ;;
#@end
  *)
    _err "No help for '$1'"
    return $EC_INVALID_ARG
    ;;
  esac
}

# =============================================================================
# COMMANDS
# =============================================================================

function _cmd_start() {
  case "${1:-}" in
  "") _start ;;
  -d | --detached) _start_background ;;
  -h | --help | help) _usage_command start ;;
  *)
    _err "Invalid argument: $1"
    return $EC_INVALID_ARG
    ;;
  esac
}

function _cmd_stop() {
  case "${1:-}" in
  -h | --help | help) _usage_command stop ;;
  *) _stop_server "$@" ;;
  esac
}

function _cmd_logs() {
  local follow=false lines=10

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -f | --follow) follow=true ;;
    -n | --tail | --lines)
      shift
      if [[ ! "${1:-}" =~ ^[0-9]+$ ]]; then
        _err "Missing or invalid number for --tail"
        return $EC_INVALID_ARG
      fi
      lines="$1"
      ;;
    -h | --help | help)
      _usage_command logs
      return $EC_SUCCESS
      ;;
    *)
      _err "Invalid argument: $1"
      return $EC_INVALID_ARG
      ;;
    esac
    shift
  done

  _print_logs "$follow" "$lines"
}

function _cmd_version() {
  if [[ $# -eq 0 ]]; then
    _installed_version
    return 0
  fi

  case "$1" in
  --compare) _version_check ;;
  --latest) _latest_version ;;
  --save)
    [[ -n "${2:-}" ]] || {
      _err "Missing argument: <version>"
      return $EC_MISSING_ARG
    }
    _save_version "$2"
    ;;
  --stored-latest) _stored_latest_version ;;
  --stored-checked-at) _stored_latest_checked_at ;;
  --save-latest)
    [[ -n "${2:-}" ]] || {
      _err "Missing argument: <version>"
      return $EC_MISSING_ARG
    }
    _save_latest_version "$2"
    ;;
  -h | --help | help) _usage_command version ;;
  *)
    _err "Invalid argument: $1"
    return $EC_INVALID_ARG
    ;;
  esac
}

function _cmd_download() {
  local version=latest

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help | help)
      _usage_command download
      return $EC_SUCCESS
      ;;
    -*)
      _err "Invalid option: $1"
      return $EC_INVALID_ARG
      ;;
    *) version="$1" ;;
    esac
    shift
  done

  _download "$version"
}

#@if native
function _cmd_launch_args() {
  local arg

  if ! _resolve_arguments "$instance_executable_arguments"; then
    _err "$RESOLVE_ERROR"
    return $EC_ERROR
  fi

  case "${1:-}" in
  "") for arg in "${RESOLVED_ARGS[@]}"; do printf '%s\n' "$arg"; done ;;
  --null) for arg in "${RESOLVED_ARGS[@]}"; do printf '%s\0' "$arg"; done ;;
  *)
    _err "Invalid argument: $1"
    return $EC_INVALID_ARG
    ;;
  esac
}
#@end

# check-update: prints available <v>, current <v> or unknown.
function _cmd_check_update() {
  _version_check
}

function _cmd_backup() {
  local sub="${1:-}"
  shift 2>/dev/null || true

  case "$sub" in
  create) _create_backup "$@" ;;
  restore)
    [[ -n "${1:-}" ]] || {
      _err "Missing argument: <backup>"
      return $EC_MISSING_ARG
    }
    _restore_backup "$@"
    ;;
  list) _list_backups ;;
  -h | --help | help) _usage_command backup ;;
  "")
    _err "Missing subcommand for backup"
    return $EC_MISSING_ARG
    ;;
  *)
    _err "Unknown backup subcommand: ${sub}"
    return $EC_INVALID_ARG
    ;;
  esac
}

# =============================================================================
# DISPATCH
# =============================================================================

# The commands that tell what the script is need no config, so help works when
# the config is damaged.
case "${1:-}" in
script-info)
  echo "template=${KGSM_TEMPLATE_VERSION} hooks=${KGSM_HOOKS_DIGEST} runtime=${KGSM_RUNTIME}"
  exit $EC_SUCCESS
  ;;
"")
  instance_name="$INSTANCE_NAME"
  _usage
  exit $EC_ERROR
  ;;
-h | --help | help)
  if [[ -n "${2:-}" ]]; then
    _usage_command "$2"
  else
    instance_name="$INSTANCE_NAME"
    _usage
  fi
  exit $?
  ;;
esac

_load_config

verb="$1"
shift

case "$verb" in
start) _cmd_start "$@" ;;
stop) _cmd_stop "$@" ;;
restart) _restart ;;
attach) _attach ;;
kill) _kill_all_processes ;;
is-active) _is_active ;;
save) _send_save_command ;;
input)
  [[ -n "${1:-}" ]] || {
    _err "Missing argument: <command>"
    exit $EC_MISSING_ARG
  }
  _send_input "$1"
  ;;
announce)
  [[ -n "${1:-}" ]] || {
    _err "Missing argument: <message>"
    exit $EC_MISSING_ARG
  }
  _send_broadcast "$1"
  ;;
kick) _send_moderation_command "${instance_kick_command}" "${1:-}" kick ;;
ban) _send_moderation_command "${instance_ban_command}" "${1:-}" ban ;;
unban) _send_moderation_command "${instance_unban_command}" "${1:-}" unban ;;
status) _status "$@" ;;
logs) _cmd_logs "$@" ;;
version) _cmd_version "$@" ;;
check-update) _cmd_check_update ;;
download) _cmd_download "$@" ;;
deploy) _deploy ;;
update) _update "$@" ;;
#@if native
launch-args) _cmd_launch_args "$@" ;;
#@end
backup) _cmd_backup "$@" ;;
backups)
  if [[ "${1:-}" == "--json" ]]; then
    _backup_manifests_json
  else
    _list_backups
  fi
  ;;
create-backup) _create_backup "$@" ;;
restore-backup)
  [[ -n "${1:-}" ]] || {
    _err "Missing argument: <id>"
    exit $EC_MISSING_ARG
  }
  _restore_backup "$@"
  ;;
pin-backup) _set_backup_retention "${1:-}" pinned ;;
unpin-backup) _set_backup_retention "${1:-}" prunable ;;
*)
  _err "Unknown command: ${verb}"
  _err "Use '${self} help' for the available commands"
  exit $EC_INVALID_ARG
  ;;
esac
exit $?
