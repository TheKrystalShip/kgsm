#!/usr/bin/env bash
#
# Management script for one game server instance, generated by kgsm.
#
# It runs without the engine: it reads <id>.config.json beside itself, derives
# every path from its own location and needs only the tools listed in the
# package. Edits here affect this instance only and are overwritten when the
# script is regenerated (kgsm instance repair).
#
# kgsm-script: template=@@TEMPLATE_VERSION@@ hooks=@@HOOKS_DIGEST@@ runtime=@@RUNTIME@@
#
# shellcheck disable=SC2034,SC2154,SC2329
# The instance_* variables are set from the config file by _load_config and are
# the values a hook reads, so a script need not use each one; the hook functions
# are called by name.

# Replacement strings in ${var//pattern/replacement} are literal, whatever
# they contain (bash 5.2 reads an unquoted & in them as the matched text).
shopt -u patsub_replacement 2>/dev/null || true

set -o pipefail

readonly EC_SUCCESS=0
readonly EC_ERROR=1
readonly EC_MISSING_ARG=7
readonly EC_INVALID_ARG=8
readonly EC_NOT_FOUND=25

readonly KGSM_TEMPLATE_VERSION=@@TEMPLATE_VERSION@@
readonly KGSM_HOOKS_DIGEST='@@HOOKS_DIGEST@@'
readonly KGSM_RUNTIME='@@RUNTIME@@'
readonly KGSM_CONFIG_SCHEMA=1

# How long a stop waits between TERM and KILL. The environment overrides it.
KGSM_TERM_GRACE_SECONDS="${KGSM_TERM_GRACE_SECONDS:-10}"

#@if native
# The keys a launch argument may name; the same set the engine core resolves.
readonly KGSM_PLACEHOLDER_KEYS='@@PLACEHOLDER_KEYS@@'

# Where the watchdog listens and where Steam credentials may live. The
# environment overrides each.
KGSM_WATCHDOG_SOCKET="${KGSM_WATCHDOG_SOCKET:-@@WATCHDOG_SOCKET@@}"
KGSM_ENV_FILE="${KGSM_ENV_FILE:-/etc/kgsm/kgsm.env}"
#@end

# =============================================================================
# MESSAGES
#
# Messages go to stderr. Stdout carries only a command's result.
# =============================================================================

function _log() {
  printf '[%s] %s\n' "$1" "$2" >&2
}

function _info() {
  _log INFO "$1"
}

function _success() {
  _log SUCCESS "$1"
}

function _warn() {
  _log WARNING "$1"
}

function _err() {
  _log ERROR "$1"
}

# =============================================================================
# CONFIGURATION
# =============================================================================

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
INSTANCE_NAME="${SCRIPT_DIR##*/}"
CONFIG_FILE="${SCRIPT_DIR}/${INSTANCE_NAME}.config.json"
self="${SCRIPT_PATH##*/}"

# The config's values by their camelCase names, and the derived paths.
declare -A CFG=()

# Reads the JSON config with jq into CFG and into instance_<snake_case>
# variables (levelName becomes instance_level_name), then derives every path
# from the script's own location. A schemaVersion the script does not know is
# refused rather than misread.
function _load_config() {
  local schema camel snake value key

  if [[ ! -f "$CONFIG_FILE" ]]; then
    _err "Configuration file not found: $CONFIG_FILE"
    exit $EC_ERROR
  fi

  if ! command -v jq >/dev/null 2>&1; then
    _err "jq is required"
    exit $EC_ERROR
  fi

  if ! schema="$(jq -r 'if type == "object" then (.schemaVersion // "none" | tostring) else "invalid" end' "$CONFIG_FILE" 2>/dev/null)"; then
    _err "Configuration file is not valid JSON: $CONFIG_FILE"
    exit $EC_ERROR
  fi

  if [[ "$schema" != "$KGSM_CONFIG_SCHEMA" ]]; then
    _err "$CONFIG_FILE has schemaVersion $schema; this script reads $KGSM_CONFIG_SCHEMA"
    exit $EC_ERROR
  fi

  while IFS= read -r -d '' camel && IFS= read -r -d '' snake && IFS= read -r -d '' value; do
    if [[ ! "$camel" =~ ^[a-z][A-Za-z0-9]*$ || ! "$snake" =~ ^[a-z][a-z0-9_]*$ ]]; then
      _err "Invalid key '$camel' in $CONFIG_FILE"
      exit $EC_ERROR
    fi
    CFG["$camel"]="$value"
    printf -v "instance_${snake}" '%s' "$value"
  done < <(jq -j 'to_entries[] | .key, "\u0000", (.key | gsub("(?<c>[A-Z])"; "_" + (.c | ascii_downcase))), "\u0000", (.value | if . == null then "" elif type == "string" then . else tojson end), "\u0000"' "$CONFIG_FILE")

  if [[ "${CFG[name]:-}" != "$INSTANCE_NAME" ]]; then
    _err "$CONFIG_FILE names instance '${CFG[name]:-}' but lies in the directory '$INSTANCE_NAME'"
    exit $EC_ERROR
  fi

  if [[ "${CFG[runtime]:-}" != "$KGSM_RUNTIME" ]]; then
    _err "This script is for the $KGSM_RUNTIME runtime but the config says '${CFG[runtime]:-}'; run kgsm instance repair"
    exit $EC_ERROR
  fi

  instance_working_dir="$SCRIPT_DIR"
  instance_install_dir="${SCRIPT_DIR}/install"
  instance_saves_dir="${SCRIPT_DIR}/saves"
  instance_logs_dir="${SCRIPT_DIR}/logs"
  instance_temp_dir="${SCRIPT_DIR}/temp"
  instance_events_dir="${SCRIPT_DIR}/events"
  instance_launch_dir="$instance_install_dir"
  if [[ -n "${CFG[executableSubdirectory]:-}" ]]; then
    instance_launch_dir="${instance_install_dir}/${CFG[executableSubdirectory]#/}"
  fi
  instance_backups_dir="${CFG[backupsDirectory]:-}"
#@if container
  instance_compose_file="${SCRIPT_DIR}/${INSTANCE_NAME}.docker-compose.yml"
#@end
  instance_version_file="${SCRIPT_DIR}/.${INSTANCE_NAME}.version"
  instance_latest_version_file="${SCRIPT_DIR}/.${INSTANCE_NAME}.latest"
  instance_pid_file="${SCRIPT_DIR}/.${INSTANCE_NAME}.pid"
  instance_socket_file="${SCRIPT_DIR}/.${INSTANCE_NAME}.sock"
  instance_log_file="${SCRIPT_DIR}/${INSTANCE_NAME}.log"

  CFG[displayName]="${CFG[displayName]:-$INSTANCE_NAME}"
  CFG[workingDir]="$instance_working_dir"
  CFG[installDir]="$instance_install_dir"
  CFG[savesDir]="$instance_saves_dir"
  CFG[logsDir]="$instance_logs_dir"
  CFG[tempDir]="$instance_temp_dir"
  CFG[eventsDir]="$instance_events_dir"
  CFG[launchDir]="$instance_launch_dir"
  CFG[backupsDir]="$instance_backups_dir"

  for key in stop_command_timeout_seconds save_command_timeout_seconds download_timeout_seconds; do
    value="instance_${key}"
    if [[ ! "${!value:-}" =~ ^[0-9]+$ ]]; then
      _err "Config key '${key}' is not a whole number of seconds: '${!value:-}'"
      exit $EC_ERROR
    fi
  done
}

#@if native
# =============================================================================
# LAUNCH ARGUMENTS
#
# The argument string is split on whitespace first; each {key} is then replaced
# inside its own argument, so a value holding spaces stays one argument and
# nothing in a value is shell syntax. {{ and }} are literal braces, a lone
# brace is an error and so is a key that has no value. The engine core resolves
# the same grammar; one set of cases checks both.
# =============================================================================

RESOLVED_ARGS=()
RESOLVE_ERROR=""

# Resolves a template into RESOLVED_ARGS. Returns 1 with RESOLVE_ERROR set when
# a brace is unmatched or a key has no value.
function _resolve_arguments() {
  local template="$1"
  local LC_ALL=C
  local IFS=$' \t\n\r\v\f'
  local -a tokens=()
  local token out key rest c next
  local i n

  RESOLVED_ARGS=()
  RESOLVE_ERROR=""

  read -r -d '' -a tokens <<<"$template" || true

  for token in "${tokens[@]}"; do
    out=""
    i=0
    n=${#token}

    while ((i < n)); do
      c="${token:i:1}"
      next="${token:i+1:1}"

      if [[ "$c" == "{" ]]; then
        if [[ "$next" == "{" ]]; then
          out+="{"
          i=$((i + 2))
          continue
        fi

        rest="${token:i+1}"
        if [[ "$rest" != *"}"* ]]; then
          RESOLVE_ERROR="'{' in '${token}' opens a placeholder that never closes; write '{{' for a literal brace"
          return 1
        fi

        key="${rest%%\}*}"
        if [[ ! "$key" =~ ^[a-z][A-Za-z0-9]*$ ]]; then
          RESOLVE_ERROR="'{${key}}' in '${token}' is not a placeholder; write '{{' for a literal brace"
          return 1
        fi

        if [[ " ${KGSM_PLACEHOLDER_KEYS} " != *" ${key} "* || -z "${CFG[$key]+x}" ]]; then
          RESOLVE_ERROR="the launch arguments name '{${key}}', which has no value"
          return 1
        fi

        out+="${CFG[$key]}"
        i=$((i + ${#key} + 2))
      elif [[ "$c" == "}" ]]; then
        if [[ "$next" == "}" ]]; then
          out+="}"
          i=$((i + 2))
          continue
        fi

        RESOLVE_ERROR="'}' in '${token}' closes nothing; write '}}' for a literal brace"
        return 1
      else
        out+="$c"
        i=$((i + 1))
      fi
    done

    RESOLVED_ARGS+=("$out")
  done

  return 0
}

# =============================================================================
# STEAM CREDENTIALS
# =============================================================================

# Echoes STEAM_USERNAME or STEAM_PASSWORD: the environment first, else the
# credentials file (KEY=value lines). The file is read, never sourced.
function _steam_credential() {
  local key="$1"
  local value="${!key:-}"
  local line name

  if [[ -n "$value" ]]; then
    printf '%s' "$value"
    return 0
  fi

  [[ -r "$KGSM_ENV_FILE" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *=* ]] || continue
    name="${line%%=*}"
    name="${name//[[:space:]]/}"
    name="${name#export}"
    [[ "$name" == "$key" ]] || continue
    value="${line#*=}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    printf '%s' "$value"
    return 0
  done <"$KGSM_ENV_FILE"

  return 0
}

STEAM_LOGIN=()

# Fills STEAM_LOGIN with the arguments that follow steamcmd's +login. The
# password is optional: a username alone spends the refresh token steamcmd
# stored at the last login that satisfied Steam Guard.
function _steam_login() {
  local username password

  STEAM_LOGIN=(anonymous)
  if [[ "$instance_is_steam_account_required" != "true" ]]; then
    return 0
  fi

  username="$(_steam_credential STEAM_USERNAME)"
  password="$(_steam_credential STEAM_PASSWORD)"
  if [[ -z "$username" ]]; then
    _err "STEAM_USERNAME is expected but it is not set"
    _err "Set it in the environment, or in ${KGSM_ENV_FILE}"
    return 1
  fi

  STEAM_LOGIN=("$username")
  if [[ -n "$password" ]]; then
    STEAM_LOGIN+=("$password")
  fi
}

# =============================================================================
# THE WATCHDOG
#
# A native instance the watchdog runs has no pid file. When its control socket
# exists the script asks it; otherwise the pid file is the whole answer.
# =============================================================================

WD_CODE=""
WD_BODY=""
WD_STATE="absent"
WD_PID=""
WD_SPAWNED=""

# One request to the control socket. Sets WD_CODE and WD_BODY; returns 1 when
# nothing answered.
function _wd_call() {
  local method="$1" path="$2" max_time="${3:-5}" out

  WD_CODE=""
  WD_BODY=""

  [[ -S "$KGSM_WATCHDOG_SOCKET" ]] || return 1
  command -v curl >/dev/null 2>&1 || return 1

  if ! out="$(curl --silent --max-time "$max_time" --unix-socket "$KGSM_WATCHDOG_SOCKET" \
    -X "$method" -w $'\n%{http_code}' "http://watchdog/${path}" 2>/dev/null)"; then
    return 1
  fi

  WD_CODE="${out##*$'\n'}"
  WD_BODY="${out%$'\n'*}"
  return 0
}

# Sets WD_STATE to running (the watchdog runs the instance), idle (it tracks
# the instance and nothing runs), untracked, unavailable (the socket does not
# answer) or absent (no socket), and WD_PID and WD_SPAWNED when it runs.
function _wd_state() {
  local populated

  WD_STATE="absent"
  WD_PID=""
  WD_SPAWNED=""

  [[ -S "$KGSM_WATCHDOG_SOCKET" ]] || return 0

  if ! _wd_call GET "status/${INSTANCE_NAME}"; then
    WD_STATE="unavailable"
    return 0
  fi

  case "$WD_CODE" in
  200)
    populated="$(jq -r '.populated // false' <<<"$WD_BODY" 2>/dev/null)"
    if [[ "$populated" == "true" ]]; then
      WD_STATE="running"
      WD_PID="$(jq -r '.pid // ""' <<<"$WD_BODY" 2>/dev/null)"
      WD_SPAWNED="$(jq -r '.spawnedAt // ""' <<<"$WD_BODY" 2>/dev/null)"
    else
      WD_STATE="idle"
    fi
    ;;
  404) WD_STATE="untracked" ;;
  *) WD_STATE="unavailable" ;;
  esac
}

# Asks the watchdog to stop or restart the instance it runs. It drains for the
# instance's whole stop timeout before it kills, so the request waits that long.
function _wd_act() {
  local action="$1" ok message
  local max_time=$((instance_stop_command_timeout_seconds + 60))

  if ! _wd_call POST "${action}/${INSTANCE_NAME}?origin=script" "$max_time"; then
    _err "The watchdog did not answer the ${action} request"
    return $EC_ERROR
  fi

  ok="$(jq -r '.ok // false' <<<"$WD_BODY" 2>/dev/null)"
  message="$(jq -r '.message // ""' <<<"$WD_BODY" 2>/dev/null)"
  if [[ "$ok" != "true" ]]; then
    _err "The watchdog refused to ${action} ${INSTANCE_NAME}: ${message:-no reason given}"
    return $EC_ERROR
  fi

  _success "The watchdog ${action}ped ${INSTANCE_NAME}"
  return $EC_SUCCESS
}

#@end
# =============================================================================
# CONSOLE INPUT
# =============================================================================

# Rejects what could turn a console line into something else.
function _sanitize_input_command() {
  local command="$1"

  if [[ -z "$command" ]]; then
    _err "Empty command provided"
    return $EC_ERROR
  fi

  if [[ ${#command} -gt 1000 ]]; then
    _err "Command too long (${#command} characters, max 1000)"
    return $EC_ERROR
  fi

  if [[ "$command" == *[\;\&\|\`\)\{\}\[\]\\\<\>\*\?\~\$\!]* ]]; then
    _err "Input command contains potentially dangerous characters"
    _err "Rejected characters: ; & | \` \$ ( ) { } [ ] \\ < > * ? ~ !"
    return $EC_ERROR
  fi

  return $EC_SUCCESS
}

# Writes one line to the console pipe. The pipe is opened read-write: a plain
# append blocks until something opens the read end, so a server that died
# leaving its pipe behind would hang the caller forever.
function _write_console_line() {
  local fifo fd

  fifo="$(_console_fifo)"
  if [[ ! -p "$fifo" ]]; then
    _err "No active server found (console pipe missing at ${fifo})"
    return $EC_ERROR
  fi

  if ! exec {fd}<>"$fifo"; then
    _err "Could not open ${fifo}"
    return $EC_ERROR
  fi

  if ! printf '%s\n' "$1" >&"$fd"; then
    exec {fd}>&-
    _err "Could not write to ${fifo}"
    return $EC_ERROR
  fi

  exec {fd}>&-
  return $EC_SUCCESS
}

# input <command>: a sanitized line to the console.
function _send_input() {
  _sanitize_input_command "$1" || return $EC_ERROR
  _require_running_for_console || return $EC_ERROR
  _write_console_line "$1"
}

# Resolves a moderation template against a target and delivers it. The
# template carries one {ip}, {name} or {id} placeholder naming the token the
# game expects.
function _send_moderation_command() {
  local template="$1" target="$2" action="$3" resolved

  if [[ -z "$template" ]]; then
    _err "$instance_name does not support '${action}': no ${action}_command is declared for this instance"
    return $EC_ERROR
  fi

  if [[ -z "$target" ]]; then
    _err "Missing target for '${action}'"
    return $EC_MISSING_ARG
  fi

  if [[ "$target" == *$'\n'* || "$target" == *$'\r'* ]]; then
    _err "Invalid target: line breaks are not allowed"
    return $EC_INVALID_ARG
  fi

  resolved="$template"
  resolved="${resolved//\{ip\}/$target}"
  resolved="${resolved//\{name\}/$target}"
  resolved="${resolved//\{id\}/$target}"

  if [[ "$resolved" == "$template" ]]; then
    _err "Malformed ${action}_command '${template}': expected one {ip}, {name} or {id} placeholder"
    return $EC_ERROR
  fi

  _send_input "$resolved"
}

# announce <message>: the broadcast template with the message in place of
# {message}. The message is prose and is checked only for a line break, the
# one thing that would deliver a second command nobody issued.
function _send_broadcast() {
  local message="$1" resolved

  if [[ -z "${instance_broadcast_command:-}" ]]; then
    _err "$instance_name does not support announcements: no broadcast_command is declared for this instance"
    return $EC_ERROR
  fi

  if [[ -z "$message" ]]; then
    _err "Missing message to announce"
    return $EC_MISSING_ARG
  fi

  if [[ "$message" == *$'\n'* || "$message" == *$'\r'* ]]; then
    _err "Invalid message: line breaks are not allowed"
    return $EC_INVALID_ARG
  fi

  if [[ ${#message} -gt 1000 ]]; then
    _err "Message too long (${#message} characters, max 1000)"
    return $EC_INVALID_ARG
  fi

  resolved="${instance_broadcast_command//\{message\}/$message}"
  if [[ "$resolved" == "$instance_broadcast_command" ]]; then
    _err "Malformed broadcast_command '${instance_broadcast_command}': expected a {message} placeholder"
    return $EC_ERROR
  fi

  _require_running_for_console || return $EC_ERROR
  _write_console_line "$resolved"
}

# save: the save command to the console, then a wait for the game to write.
function _send_save_command() {
  if [[ -z "${instance_save_command:-}" ]]; then
    _warn "No save command is declared for this instance"
    return $EC_SUCCESS
  fi

  _require_running_for_console || return $EC_ERROR
  _write_console_line "$instance_save_command" || return $EC_ERROR
  sleep "${instance_save_command_timeout_seconds}"
  return $EC_SUCCESS
}

# =============================================================================
# LOGS
# =============================================================================

# Renames a non-empty live log to <logs>/<id>.<last write, UTC>.log. The run is
# named by when it ended: the file's last write is the last line the server
# printed. A nanosecond suffix keeps two runs that end in one second apart.
function _rotate_log_file() {
  local log_file="$instance_log_file" timestamp rotated

  [[ -s "$log_file" ]] || return $EC_SUCCESS

  if ! mkdir -p "$instance_logs_dir"; then
    _err "Could not create ${instance_logs_dir}"
    return $EC_ERROR
  fi

  timestamp="$(date -u -r "$log_file" +"%Y-%m-%dT%H:%M:%S")"
  rotated="${instance_logs_dir}/${INSTANCE_NAME}.${timestamp}.log"
  if [[ -e "$rotated" ]]; then
    rotated="${instance_logs_dir}/${INSTANCE_NAME}.${timestamp}.$(date -u +%s%N).log"
  fi

  if ! mv "$log_file" "$rotated"; then
    _err "Failed to rotate log file ${log_file} to ${rotated}"
    return $EC_ERROR
  fi

  _info "Rotated log file to ${rotated}"
  return $EC_SUCCESS
}

# The file recent output is read from: the live log, else the newest rotated
# log, else nothing.
function _recent_log_source() {
  local newest

  if [[ -s "$instance_log_file" ]]; then
    printf '%s' "$instance_log_file"
    return 0
  fi

  [[ -d "$instance_logs_dir" ]] || return 0
  newest="$(find "$instance_logs_dir" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1)"
  [[ -n "$newest" ]] && printf '%s' "${newest#* }"
  return 0
}

# =============================================================================
# HELPERS
# =============================================================================

function _dir_has_files() {
  [[ -n "$(find "$1" -mindepth 1 -print -quit 2>/dev/null)" ]]
}

function _clear_dir() {
  [[ -d "$1" ]] || return 0
  find "$1" -mindepth 1 -delete
}

function _now_ms() {
  local t="${EPOCHREALTIME/[.,]/}"
  printf '%s' "$((t / 1000))"
}

# A date string (ps lstart in local time, or an RFC 3339 timestamp) as
# ISO-8601 UTC, or nothing.
function _to_iso_utc() {
  [[ -n "$1" ]] || return 0
  date -d "$1" -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || return 0
}

# Reports one update phase through the command the caller handed in, as
# <command> <phase> <instance>. Never fatal: the update is the job, but a
# reporting path that fails quietly is indistinguishable from one never wired.
EMIT_CMD=()

function _emit_phase() {
  local out

  ((${#EMIT_CMD[@]} > 0)) || return 0
  if ! out="$("${EMIT_CMD[@]}" "$1" "$INSTANCE_NAME" 2>&1)"; then
    _warn "Could not report phase $1: ${out:-no detail}"
  fi
}

# =============================================================================
# VERSIONS
#
# The installed version is the first line of the version file, "unknown" when
# there is none. The latest-version record is two lines, the version and the
# moment it was fetched, written only after a real fetch.
# =============================================================================

function _installed_version() {
  local version=""

  if [[ -s "$instance_version_file" ]]; then
    IFS= read -r version <"$instance_version_file" || true
  fi

  printf '%s\n' "${version:-unknown}"
}

function _save_version() {
  local version="$1"

  if [[ -z "$version" ]]; then
    _err "Refusing to record an empty version"
    return $EC_INVALID_ARG
  fi

  printf '%s\n' "$version" >"$instance_version_file" || return $EC_ERROR
  _success "Version saved: ${version}"
}

# The recorded upstream version, or nothing when no check has ever run.
function _stored_latest_version() {
  [[ -s "$instance_latest_version_file" ]] || return 0
  head -n1 "$instance_latest_version_file"
}

# When that version was fetched (ISO-8601 UTC), or nothing. A recorded version
# with no recorded time reads as unknown; "now" is never substituted.
function _stored_latest_checked_at() {
  [[ -s "$instance_latest_version_file" ]] || return 0
  sed -n '2p' "$instance_latest_version_file"
}

# Records an upstream version as of this call, which is why only a path that
# has just completed a real fetch calls it.
function _save_latest_version() {
  local version="$1"

  if [[ -z "$version" ]]; then
    _err "Refusing to record an empty upstream version"
    return $EC_INVALID_ARG
  fi

  printf '%s\n%s\n' "$version" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >"$instance_latest_version_file" || return $EC_ERROR
}

# Prints the outcome of asking upstream: "available <latest>", "current
# <latest>" or "unknown". Returns 0 when upstream answered, 1 when it did not.
# Unknown is never reported as current.
function _version_check() {
  local latest installed

  if ! latest="$(_latest_version)"; then
    echo "unknown"
    return $EC_ERROR
  fi

  installed="$(_installed_version)"
  if [[ "$installed" == "$latest" ]]; then
    echo "current ${latest}"
  else
    echo "available ${latest}"
  fi
  return $EC_SUCCESS
}

#@if native
# =============================================================================
# NATIVE: VERSIONS, DOWNLOAD AND DEPLOY
# =============================================================================

# The version a hook-less Steam game is at upstream: the public branch's build
# id, as steamcmd prints it.
function _steam_latest_version() {
  local output flat

  if [[ -z "${instance_steam_app_id:-}" || "${instance_steam_app_id}" == "0" ]]; then
    _err "This instance has no Steam app id and no latest-version hook"
    return 1
  fi

  _steam_login || return 1

  if ! output="$(steamcmd +login "${STEAM_LOGIN[@]}" +app_info_update 1 \
    +app_info_print "$instance_steam_app_id" +quit)"; then
    _err "steamcmd failed asking for app ${instance_steam_app_id}"
    return 1
  fi

  flat="$(printf '%s' "$output" | tr '\n' ' ')"
  if [[ "$flat" =~ \"branches\"[[:space:]]*\{[[:space:]]*\"public\"[[:space:]]*\{[[:space:]]*\"buildid\"[[:space:]]*\"([0-9]+)\" ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi

  _err "Failed to retrieve the latest version: steamcmd returned no build id"
  return 1
}

# The latest version upstream: the game's hook when it has one, else steamcmd.
# Returns 1 when upstream did not answer.
function _latest_version() {
  local output rc

  if declare -F kgsm_hook_latest_version >/dev/null; then
    output="$(_run_hook kgsm_hook_latest_version)"
    rc=$?
    if ((rc != 0)); then
      _err "The latest-version hook failed"
      return 1
    fi
    output="${output%%$'\n'*}"
    output="${output#"${output%%[![:space:]]*}"}"
    output="${output%"${output##*[![:space:]]}"}"
    if [[ -z "$output" ]]; then
      _err "The latest-version hook returned no version"
      return 1
    fi
    printf '%s\n' "$output"
    return 0
  fi

  _steam_latest_version
}

# Where a download lands and a deploy reads from. Backups stage elsewhere, so a
# running backup is never mistaken for downloaded game files.
function _staging_dir() {
  printf '%s' "${instance_temp_dir}/download"
}

# Runs a hook in a subshell under set -e, so a failing step fails the hook.
# Callers run it as a statement and read its status afterwards: inside an if
# or a || list bash ignores set -e, and with it every check the hook relies on.
function _run_hook() {
  local name="$1" rc
  shift

  (
    set -e
    "$name" "$@"
  )
  rc=$?
  return $rc
}

function _steam_download() {
  local dest="$1"
  local -a extra=()

  if [[ -z "${instance_steam_app_id:-}" || "${instance_steam_app_id}" == "0" ]]; then
    _err "This instance has no Steam app id and no download hook"
    return 1
  fi

  _steam_login || return 1

  if [[ -n "${instance_steamcmd_arguments:-}" ]]; then
    read -r -a extra <<<"$instance_steamcmd_arguments"
  fi

  if ! steamcmd \
    +@sSteamCmdForcePlatformType "${instance_platform:-linux}" \
    +force_install_dir "$dest" \
    +login "${STEAM_LOGIN[@]}" \
    +app_update "$instance_steam_app_id" "${extra[@]}" \
    validate \
    +quit; then
    _err "steamcmd exited non-zero downloading app ${instance_steam_app_id}"
    return 1
  fi

  # steamcmd reports success it did not achieve: a login that never completed
  # still exits 0 with a manifest and no depots. Content on disk is the only
  # signal of a real download.
  if [[ -z "$(find "$dest" -mindepth 1 -type f -not -path "${dest}/steamapps/*" -print -quit 2>/dev/null)" ]]; then
    _err "steamcmd reported success but downloaded no game files"
    _err "Verify the Steam credentials, and that the account owns app ${instance_steam_app_id}"
    return 1
  fi
}

# download [version]: the game's files, into the staging directory. A hook is
# handed the exact version; "latest" is resolved here first.
function _download() {
  local version="${1:-latest}" dest rc

  dest="$(_staging_dir)"
  _info "Downloading..."

  if ! _clear_dir "$dest" || ! mkdir -p "$dest"; then
    _err "Could not prepare ${dest}"
    return $EC_ERROR
  fi

  if declare -F kgsm_hook_download >/dev/null; then
    if [[ "$version" == "latest" || "$version" == "0" ]]; then
      if ! version="$(_latest_version)"; then
        _err "Could not resolve the latest version to download"
        return $EC_ERROR
      fi
    fi

    _run_hook kgsm_hook_download "$version" "$dest"
    rc=$?
    if ((rc != 0)); then
      _err "The download hook failed"
      return $EC_ERROR
    fi

    if ! _dir_has_files "$dest"; then
      _err "The download hook left ${dest} empty"
      return $EC_ERROR
    fi
  else
    if [[ "$version" != "latest" && "$version" != "0" ]]; then
      _warn "Version '${version}' is ignored: Steam downloads only the latest version"
    fi
    _steam_download "$dest" || return $EC_ERROR
  fi

  _success "Download complete"
}

# deploy: the staged files into the install directory, then the game's
# finishing steps, then the staging directory is cleared.
function _deploy() {
  local staging dest="$instance_install_dir" rc

  staging="$(_staging_dir)"
  _info "Deploying..."

  if [[ ! -d "$staging" ]] || ! _dir_has_files "$staging"; then
    _err "${staging} is empty, nothing to deploy"
    return $EC_ERROR
  fi

  if ! mkdir -p "$dest"; then
    _err "Could not create ${dest}"
    return $EC_ERROR
  fi

  if declare -F kgsm_hook_deploy >/dev/null; then
    _run_hook kgsm_hook_deploy "$staging" "$dest"
    rc=$?
    if ((rc != 0)); then
      _err "The deploy hook failed"
      return $EC_ERROR
    fi
  elif ! cp -a "${staging}/." "${dest}/"; then
    _err "Failed to copy ${staging} into ${dest}"
    return $EC_ERROR
  fi

  if declare -F kgsm_hook_post_deploy >/dev/null; then
    _run_hook kgsm_hook_post_deploy "$dest"
    rc=$?
    if ((rc != 0)); then
      _err "The post-deploy hook failed"
      return $EC_ERROR
    fi
  fi

  if ! _clear_dir "$staging"; then
    _err "Failed to clear ${staging}"
    return $EC_ERROR
  fi

  _success "Deploy complete"
}

# =============================================================================
# NATIVE: PROCESSES
# =============================================================================

function _console_fifo() {
  printf '%s' "$instance_socket_file"
}

function _require_running_for_console() {
  return 0
}

# Whether a pid is a live process. A zombie is not.
function _pid_alive() {
  local pid="$1" state

  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null)"
  [[ -n "$state" && "$state" != Z* ]]
}

# Waits until none of the pids is alive or the seconds pass. Returns 1 on timeout.
function _wait_dead() {
  local seconds="$1" pid alive deadline
  shift
  deadline=$(($(_now_ms) + seconds * 1000))

  while :; do
    alive=0
    for pid in "$@"; do
      if _pid_alive "$pid"; then
        alive=1
        break
      fi
    done
    ((alive)) || return 0
    (($(_now_ms) >= deadline)) && return 1
    sleep 0.1
  done
}

# Prints a pid and every descendant of it, one per line.
function _process_tree() {
  local pid="$1" child

  printf '%s\n' "$pid"
  while IFS= read -r child; do
    [[ -n "$child" ]] && _process_tree "$child"
  done < <(pgrep -P "$pid" 2>/dev/null)
}

function _read_pid() {
  local pid

  pid="$(cat "$instance_pid_file" 2>/dev/null)" || return 1
  pid="${pid//[[:space:]]/}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$pid"
}

# Active or Inactive, on stdout; the exit status says the same. The watchdog is
# asked when its socket exists; the pid file is the witness for a run outside
# its supervision. A stale pid file is removed.
function _is_active() {
  local pid

  _wd_state
  if [[ "$WD_STATE" == "running" ]]; then
    echo "Active"
    return $EC_SUCCESS
  fi

  if [[ -e "$instance_pid_file" ]]; then
    if pid="$(_read_pid)" && _pid_alive "$pid"; then
      echo "Active"
      return $EC_SUCCESS
    fi
    rm -f "$instance_pid_file"
  fi

  echo "Inactive"
  return $EC_ERROR
}

# start -d: rotate the log, update first when the instance asks for it, then
# launch the game with its stdin on the console pipe and its output in the log.
function _start_background() {
  local pid exe fifo="$instance_socket_file"

  if _is_active >/dev/null 2>&1; then
    _err "Instance '${instance_name}' is already running"
    return $EC_ERROR
  fi

  if ! _rotate_log_file; then
    _err "Failed to rotate the log file; aborting to prevent data loss"
    return $EC_ERROR
  fi

  if [[ "$instance_auto_update_before_start" == "true" ]]; then
    if ! _update --run-state inactive >/dev/null; then
      _err "Failed to update ${instance_name}; not starting"
      return $EC_ERROR
    fi
  fi

  if ! _resolve_arguments "$instance_executable_arguments"; then
    _err "$RESOLVE_ERROR"
    return $EC_ERROR
  fi

  exe="$instance_executable_file"
  if [[ -z "$exe" ]]; then
    _err "The config names no executable"
    return $EC_ERROR
  fi

  if ! cd "$instance_launch_dir" 2>/dev/null; then
    _err "Failed to move into ${instance_launch_dir}"
    return $EC_ERROR
  fi

  if [[ "$exe" == */* ]]; then
    if [[ ! -x "$exe" ]]; then
      _err "${exe} is not an executable file in ${instance_launch_dir}"
      return $EC_ERROR
    fi
  elif ! command -v "$exe" >/dev/null 2>&1; then
    _err "${exe} is not on the PATH"
    return $EC_ERROR
  fi

  rm -f "$fifo"
  if ! mkfifo "$fifo"; then
    _err "Could not create the console pipe ${fifo}"
    return $EC_ERROR
  fi

  "$exe" "${RESOLVED_ARGS[@]}" <"$fifo" >"$instance_log_file" 2>&1 &
  pid=$!

  if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
    _err "Failed to start the server process"
    rm -f "$fifo"
    return $EC_ERROR
  fi

  printf '%s\n' "$pid" >"$instance_pid_file"

  # A writer holds the pipe open so the game never reads end-of-file; it exits
  # with the game.
  tail -f /dev/null --pid="$pid" >"$fifo" 2>/dev/null </dev/null &
  disown -a 2>/dev/null || true

  _success "Instance ${instance_name} started with PID ${pid}"
}

# start: start in the background, then attach.
function _start() {
  _start_background || return $?
  sleep 1
  _attach
}

# Sends TERM or KILL to a pid list.
function _signal_all() {
  local signal="$1" pid
  shift

  for pid in "$@"; do
    kill "-${signal}" "$pid" 2>/dev/null || true
  done
}

# Ends what is left of a process tree with TERM, and with KILL for what
# outlives the grace. The arguments are the leader, the grace in seconds and the
# pids the tree held before the stop began; the leader's tree is read again, so
# a child started since is ended too. Returns 1 if something survives KILL.
function _terminate_tree() {
  local leader="$1" grace="$2" pid
  local -a known=("${@:3}") live=()

  _tree_survivors "$leader" "${known[@]}"
  live=("${SURVIVORS[@]}")
  ((${#live[@]})) || return 0

  _signal_all TERM "${live[@]}"
  if _wait_dead "$grace" "${live[@]}"; then
    return 0
  fi

  _warn "The process did not exit ${grace} s after TERM; sending KILL"
  _tree_survivors "$leader" "${live[@]}"
  live=("${SURVIVORS[@]}")
  _signal_all KILL "${live[@]}"
  _wait_dead 5 "${live[@]}"
  for pid in "${live[@]}"; do
    _pid_alive "$pid" && return 1
  done
  return 0
}

SURVIVORS=()

# Sets SURVIVORS to the live pids among the given ones and the leader's tree.
function _tree_survivors() {
  local leader="$1" pid
  shift

  SURVIVORS=()
  local -A seen=()
  if _pid_alive "$leader"; then
    while IFS= read -r pid; do
      [[ -n "$pid" && -z "${seen[$pid]:-}" ]] && seen["$pid"]=1 && SURVIVORS+=("$pid")
    done < <(_process_tree "$leader")
  fi

  for pid in "$@"; do
    if [[ -z "${seen[$pid]:-}" ]] && _pid_alive "$pid"; then
      seen["$pid"]=1
      SURVIVORS+=("$pid")
    fi
  done
}

function _forget_process_files() {
  rm -f "$instance_pid_file" "$instance_socket_file"
}

# stop [--no-save] [--no-graceful]: the save command, then the game's stop
# command, a wait of the stop timeout, then TERM, and KILL when TERM is not
# enough. An instance the watchdog runs is stopped through the watchdog.
function _stop_server() {
  local save=1 graceful=1 arg pid sent=0
  local timeout="$instance_stop_command_timeout_seconds"
  local -a tree

  for arg in "$@"; do
    case "$arg" in
    --no-save) save=0 ;;
    --no-graceful) graceful=0 ;;
    *)
      _err "Invalid argument: ${arg}"
      return $EC_INVALID_ARG
      ;;
    esac
  done

  if ! _is_active >/dev/null 2>&1; then
    _info "Instance '${instance_name}' is not running"
    return $EC_SUCCESS
  fi

  if [[ "$WD_STATE" == "running" ]]; then
    if ((!save || !graceful)); then
      _warn "The watchdog stops the instances it runs; --no-save and --no-graceful do not apply"
    fi
    _wd_act stop
    return $?
  fi

  pid="$(_read_pid)" || return $EC_ERROR
  _info "Stopping ${instance_name}"
  mapfile -t tree < <(_process_tree "$pid")

  if ((save)); then
    _send_save_command || _warn "The save command did not reach the server"
  fi

  if ((graceful)) && [[ -n "${instance_stop_command:-}" ]]; then
    if _write_console_line "$instance_stop_command"; then
      sent=1
    else
      _warn "The stop command did not reach the server"
    fi
  fi

  if ((sent)); then
    if ! _wait_dead "$timeout" "${tree[@]}"; then
      _warn "The server did not exit ${timeout} s after its stop command"
    fi
  fi

  if ! _terminate_tree "$pid" "$KGSM_TERM_GRACE_SECONDS" "${tree[@]}"; then
    _err "Instance '${instance_name}' did not stop"
    return $EC_ERROR
  fi

  _forget_process_files
  _success "Instance '${instance_name}' stopped"
}

# restart: stop, then start. An instance the watchdog runs is restarted by it.
function _restart() {
  _wd_state
  if [[ "$WD_STATE" == "running" ]]; then
    _wd_act restart
    return $?
  fi

  _stop_server || return $?
  _start_background
}

# kill: end the process tree at once.
function _kill_all_processes() {
  local pid

  _wd_state
  if [[ "$WD_STATE" == "running" ]]; then
    _warn "The watchdog runs this instance; asking it to stop"
    _wd_act stop
    return $?
  fi

  if ! pid="$(_read_pid)"; then
    _err "No live PID file found for ${instance_name}"
    _err "If this is unexpected, check running processes to ensure the instance is not running uncontrolled"
    return $EC_ERROR
  fi

  local -a tree
  mapfile -t tree < <(_process_tree "$pid")
  _signal_all KILL "${tree[@]}"
  if ! _wait_dead 5 "${tree[@]}"; then
    _err "Instance '${instance_name}' survived KILL"
    return $EC_ERROR
  fi

  _forget_process_files
  _success "Instance '${instance_name}' killed"
}

# attach: follow the log and read console lines until .detach or Ctrl+C.
ATTACH_INTERRUPTED=0

function _attach() {
  local line follower

  if ! _is_active >/dev/null 2>&1; then
    _err "Cannot attach: ${instance_name} is not running"
    return $EC_ERROR
  fi

  _info "Attaching to ${instance_name}; type '.detach' to leave (the server keeps running), Ctrl+C stops it"

  tail -n 50 -F --pid=$$ "$instance_log_file" 2>/dev/null &
  follower=$!

  ATTACH_INTERRUPTED=0
  trap 'ATTACH_INTERRUPTED=1' INT

  while IFS= read -r -e -p "[${instance_name}]> " line; do
    if ! _is_active >/dev/null 2>&1; then
      _info "${instance_name} has stopped"
      break
    fi

    if [[ "$line" == ".detach" ]]; then
      _info "Detaching from ${instance_name}; use '${self} attach' to attach again"
      break
    fi

    [[ -z "$line" ]] && continue

    if ! _sanitize_input_command "$line"; then
      _err "Input rejected"
      continue
    fi
    _write_console_line "$line" || break
  done

  kill "$follower" 2>/dev/null || true
  trap - INT
  if ((ATTACH_INTERRUPTED)); then
    echo
    _stop_server
  fi
}

# =============================================================================
# NATIVE: STATUS
# =============================================================================

# Sets STATUS_PID, STATUS_STATE and STATUS_START for the running instance.
function _process_facts() {
  local pid ps_output lstart

  STATUS_PID=""
  STATUS_STATE=""
  STATUS_START=""

  if [[ "$WD_STATE" == "running" ]]; then
    STATUS_PID="$WD_PID"
    STATUS_STATE="running"
    STATUS_START="$WD_SPAWNED"
    return 0
  fi

  pid="$(_read_pid)" || return 0
  STATUS_PID="$pid"
  ps_output="$(ps -p "$pid" -o state=,lstart= 2>/dev/null)"
  if [[ -n "$ps_output" ]]; then
    read -r STATUS_STATE lstart <<<"$ps_output"
    STATUS_START="$(_to_iso_utc "$lstart")"
  fi
}

function _recent_logs_json() {
  local source

  source="$(_recent_log_source)"
  if [[ -z "$source" ]]; then
    echo '[]'
    return 0
  fi

  tail -n 3 "$source" 2>/dev/null | jq -R -s -c 'rtrimstr("\n") | split("\n")'
}

# Lines a runtime adds to the text status of a running instance.
function _status_extra() {
  :
}
