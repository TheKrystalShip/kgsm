# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# The KGSM engine: one Native-AOT binary with the system blueprints, the system hook files and the
# manifests that describe it.
#
# Build from this directory:  cd packaging && makepkg
#
# Compiles nothing. CI publishes first and this places the result, so the packaged bytes are the
# tested bytes. Point KGSM_STAGE at that publish output, or leave it unset to use
# ../artifacts/publish.
#
# The install prefix is /opt/kgsm, the directory the binary resolves its install root from: the
# system blueprints, the system hook files and kgsm.settings.json sit beside it. /usr/bin/kgsm is
# the link every unit and every component names.

pkgname=kgsm
# A placeholder: pkgver() below replaces it with what deploy/version.sh reports, so the number is
# declared in exactly one place and this file never carries a copy that can fall behind.
pkgver=4.0.3
pkgrel=1
pkgdesc="Krystal Game Server Manager — native engine for game-server instances"
arch=('x86_64')
url="https://github.com/TheKrystalShip/kgsm"
license=('GPL-3.0-or-later')
groups=('kgsm-node')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug' '!strip')
install="${pkgname}.install"

depends=(
    # The shared base: the kgsm service account, the /var/lib/kgsm tree every component writes
    # into, and the preset policy deciding which units a node runs.
    'kgsm-base'
    'glibc'
    'systemd'
    # The tools a generated management script runs.
    'bash'
    'coreutils' 'findutils'
    'jq'
    'curl'
    'tar'
    'procps-ng'
)
optdepends=(
    'kgsm-watchdog: supervision, autostart and crash-restart for native instances'
    'kgsm-firewall: opening and closing instance ports on the host firewall'
    'steamcmd: install and update Steam-distributed game servers'
    'docker: container-kind instances'
    'docker-compose: multi-service container instances'
    'openbsd-netcat: probing whether an instance port is reachable from outside'
)

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/../artifacts/publish}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -e "${stage}/kgsm" ]] || {
        printf '\n  no publish output at %s\n' "$stage" >&2
        printf '  build it first:  dotnet publish src/Cli/Cli.csproj -c Release -r linux-x64 -o artifacts/publish\n' >&2
        printf '  or point KGSM_STAGE at an existing one.\n\n' >&2
        return 1
    }
}

package() {
    local repo="${startdir}/.." stage; stage="$(_stage)"
    local prefix="${pkgdir}/opt/${pkgname}"

    # The binary and the settings file beside it, which is the lowest-precedence settings source.
    install -dm755 "$prefix"
    install -m755 "${stage}/kgsm" "${prefix}/kgsm"
    install -m644 "${stage}/kgsm.settings.json" "${prefix}/kgsm.settings.json"

    # The system blueprints, one flat directory of .bp.yaml files.
    install -dm755 "${prefix}/blueprints"
    install -m644 "${repo}"/blueprints/*.bp.yaml "${prefix}/blueprints/"

    # The system hook files, one per game: overrides/<name>/hooks.sh.
    local hooks name
    for hooks in "${repo}"/overrides/*/hooks.sh; do
        name="$(basename "$(dirname "$hooks")")"
        install -Dm644 "$hooks" "${prefix}/overrides/${name}/hooks.sh"
    done

    # The entry point on PATH. /usr/bin, never /usr/local/bin: /usr/local belongs to the local
    # administrator and no package may write there.
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/opt/${pkgname}/kgsm" "${pkgdir}/usr/bin/${pkgname}"

    # The config descriptor and the two generated action manifests, in the directories kgsm-api
    # scans and serves. The build generates them from the settings class and the commands and the
    # stage carries them, so they can never describe a different build than the binary beside them.
    install -Dm644 "${stage}/kgsm.leaf.json" \
        "${pkgdir}/var/lib/kgsm/leaves/engine.json"
    install -Dm644 "${stage}/kgsm.leaf.actions.json" \
        "${pkgdir}/var/lib/kgsm/leaves/actions/engine.json"
    install -Dm644 "${stage}/kgsm.kgsm.actions.json" \
        "${pkgdir}/var/lib/kgsm/leaves/actions/kgsm.json"

    # The service account and the /var/lib/kgsm tree belong to kgsm-base, which every kgsm package
    # depends on: they are written by several components and owned by none of them.

    # Journal retention. System units running as the kgsm account: one `systemctl enable` covers a
    # node with no login session, which `systemctl --user` cannot.
    install -Dm644 "${repo}/deploy/kgsm-journal-prune.service" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-journal-prune.service"
    install -Dm644 "${repo}/deploy/kgsm-journal-prune.timer" \
        "${pkgdir}/usr/lib/systemd/system/kgsm-journal-prune.timer"

    install -Dm644 "${repo}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
